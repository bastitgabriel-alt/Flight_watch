        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Analytics</string>
            <string name="Source"><![CDATA[--!strict
-- Statistiques de jeu (AnalyticsService de Roblox), visibles sur le Creator Hub
-- dans l'onglet Analytics une fois le jeu publié. Les erreurs sont ignorées :
-- les statistiques ne doivent jamais empêcher le jeu de marcher.

local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

-- Événement libre (ex. « SessionLength », valeur en secondes)
function Analytics.event(player: Player, name: string, value: number?)
	pcall(function()
		AnalyticsService:LogCustomEvent(player, name, value or 1)
	end)
end

-- Étape du tutoriel (entonnoir d'accueil)
function Analytics.funnel(player: Player, step: number, stepName: string)
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
end

-- « Première fois » (première capture, premier achat...) : enregistré une seule fois
function Analytics.first(player: Player, data: any, key: string)
	if data.Firsts[key] then
		return
	end
	data.Firsts[key] = true
	Analytics.event(player, `First{key}`)
end

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CollisionGroups</string>
            <string name="Source"><![CDATA[--!strict
-- Groupes de collision : la barrière de verrou d'un hôtel bloque tout le monde
-- sauf son propriétaire et les clients de la réception.

local PhysicsService = game:GetService("PhysicsService")

local CollisionGroups = {}

CollisionGroups.GUESTS = "Guests"

function CollisionGroups.barrier(hotelIndex: number): string
	return `Barrier{hotelIndex}`
end

function CollisionGroups.owner(hotelIndex: number): string
	return `Owner{hotelIndex}`
end

local function register(name: string)
	if not PhysicsService:IsCollisionGroupRegistered(name) then
		PhysicsService:RegisterCollisionGroup(name)
	end
end

-- À appeler une fois au démarrage (sans risque si appelé plusieurs fois)
function CollisionGroups.setup(hotelCount: number)
	register(CollisionGroups.GUESTS)
	for index = 1, hotelCount do
		local barrier = CollisionGroups.barrier(index)
		local owner = CollisionGroups.owner(index)
		register(barrier)
		register(owner)
		PhysicsService:CollisionGroupSetCollidable(owner, barrier, false)
		PhysicsService:CollisionGroupSetCollidable(CollisionGroups.GUESTS, barrier, false)
	end
end

-- Met toutes les pièces d'un modèle (et celles ajoutées plus tard) dans un groupe
function CollisionGroups.assign(model: Instance, group: string): RBXScriptConnection
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end
	return model.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end)
end

return CollisionGroups
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">DataSchema</string>
            <string name="Source"><![CDATA[--!strict
-- Structure des données sauvegardées de chaque joueur + migrations.
--
-- Pour changer la structure plus tard :
--   1. augmenter VERSION de 1
--   2. ajouter une fonction dans MIGRATIONS[ancienne version] qui transforme
--      les anciennes données vers la nouvelle forme
-- Les nouveaux champs simples sont ajoutés automatiquement (Reconcile).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))

local VERSION = 1

local TEMPLATE = {
	DataVersion = VERSION,

	Money = EconomyConfig.StartingMoney,
	Rebirths = 0,
	RebirthMultiplier = 1,

	-- Anomalies possédées : { [uid] = { Id, Mutation, Cell } }, uid = "a1", "a2"...
	Anomalies = {},
	NextAnomalyUid = 1,
	CellsUnlocked = GameConfig.BaseCells,

	Tools = {}, -- { [toolId] = true }
	SecurityUpgrades = {}, -- { [upgradeId] = niveau }
	Discovered = {}, -- { [anomalyId] = true } pour le catalogue

	Stats = {
		Captures = 0,
		WrongCaptures = 0,
		Escaped = 0,
		GuestsServed = 0,
		StealsSucceeded = 0,
		StealsSuffered = 0,
	},

	LastLogin = 0, -- os.time() de la dernière connexion
	LoginStreak = 0,
	GamepassCache = {}, -- { [gamepassId en texte] = true }
	ProcessedReceipts = {}, -- { [purchaseId] = true } achats Robux déjà traités
	ReceiptOrder = {}, -- ordre des achats (pour ne garder que les derniers)
	LuckyUntil = 0, -- os.time() de fin de la « Nuit chanceuse »
	CatalogRewards = {}, -- { [palier en texte] = true } récompenses du catalogue reçues
	Firsts = {}, -- { [nom] = true } « premières fois » déjà envoyées aux statistiques
	TutorialDone = false,
}

-- MIGRATIONS[n] transforme des données de la version n vers la version n + 1
local MIGRATIONS: { [number]: (data: any) -> () } = {
	-- [1] = function(data) data.NouveauChamp = data.AncienChamp end,
}

local DataSchema = {}

DataSchema.VERSION = VERSION
DataSchema.TEMPLATE = TEMPLATE

function DataSchema.migrate(data: any)
	if type(data.DataVersion) ~= "number" then
		data.DataVersion = VERSION
	end
	while data.DataVersion < VERSION do
		local migration = MIGRATIONS[data.DataVersion]
		if migration then
			migration(data)
		end
		data.DataVersion += 1
	end
end

return DataSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">GuestGenerator</string>
            <string name="Source"><![CDATA[--!strict
-- Génère les clients de la réception : nom, apparence, photo, registre,
-- et, pour les anomalies déguisées, leurs indices.
-- Module « pur » (aucun effet sur le jeu), testable séparément.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Types = require(Shared:WaitForChild("Types"))
local AnomalyConfig = require(Config:WaitForChild("AnomalyConfig"))
local GuestConfig = require(Config:WaitForChild("GuestConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))

export type Options = {
	AnomalyChance: number?, -- remplace GuestConfig.AnomalyChance
	RarityLuck: number?, -- multiplie les poids des raretés non communes (bonus)
	ForceAnomaly: boolean?, -- true = anomalie, false = vrai client, nil = hasard
	ForceAnomalyId: string?,
}

local GuestGenerator = {}

local HIDDEN_CLUES: { Types.ClueType } = { "UV", "Thermal" }

-- Température d'un humain normal, ou d'une anomalie glacée
local function normalTemperature(rng: Random): number
	return math.floor(rng:NextNumber(36.2, 37.4) * 10) / 10
end
local function coldTemperature(rng: Random): number
	return math.floor(rng:NextNumber(6, 18) * 10) / 10
end

local function pick<T>(rng: Random, list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

local function shuffle<T>(rng: Random, list: { T })
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
end

local function randomName(rng: Random): string
	return pick(rng, GuestConfig.FirstNames) .. " " .. pick(rng, GuestConfig.LastNames)
end

local function randomAppearance(rng: Random): Types.Appearance
	return {
		Skin = pick(rng, GuestConfig.SkinTones),
		Shirt = pick(rng, GuestConfig.ClothColors),
		Pants = pick(rng, GuestConfig.ClothColors),
	}
end

-- Choisit une couleur différente de « current » dans la liste
local function differentColor(rng: Random, list: { Color3 }, current: Color3): Color3
	local others = {}
	for _, color in list do
		if color ~= current then
			table.insert(others, color)
		end
	end
	return if #others > 0 then pick(rng, others) else current
end

-- Fausse le nom de famille en échangeant deux lettres voisines
-- (« Dubois » -> « Dubios »). Sert d'indice discret dans le registre.
function GuestGenerator.misspell(rng: Random, fullName: string): string
	local space = string.find(fullName, " ", 1, true)
	if not space then
		return fullName .. "e"
	end
	local first = string.sub(fullName, 1, space)
	local last = string.sub(fullName, space + 1)
	-- Positions où deux lettres voisines sont différentes (on garde la 1re lettre)
	local candidates = {}
	for i = 2, #last - 1 do
		local a, b = string.sub(last, i, i), string.sub(last, i + 1, i + 1)
		if a ~= b and string.match(a, "%a") and string.match(b, "%a") then
			table.insert(candidates, i)
		end
	end
	if #candidates == 0 then
		return first .. last .. "e"
	end
	local i = pick(rng, candidates)
	local swapped = string.sub(last, 1, i - 1)
		.. string.sub(last, i + 1, i + 1)
		.. string.sub(last, i, i)
		.. string.sub(last, i + 2)
	return first .. swapped
end

-- Tire une rareté selon les poids (RarityLuck augmente les raretés hautes)
function GuestGenerator.rollRarity(rng: Random, rarityLuck: number?): Types.RarityId
	local luck = rarityLuck or 1
	local entries: { { id: Types.RarityId, weight: number } } = {}
	local total = 0
	for id, rarity in RarityConfig do
		local weight = rarity.SpawnWeight
		if id ~= "Common" then
			weight *= luck
		end
		-- Une rareté sans anomalie configurée ne peut pas sortir
		local hasAnomaly = false
		for _, def in AnomalyConfig.List do
			if def.Rarity == id then
				hasAnomaly = true
				break
			end
		end
		if weight > 0 and hasAnomaly then
			table.insert(entries, { id = id, weight = weight })
			total += weight
		end
	end
	-- Ordre stable pour que les tests soient reproductibles
	table.sort(entries, function(a, b)
		return RarityConfig[a.id].Order < RarityConfig[b.id].Order
	end)
	local roll = rng:NextNumber() * total
	for _, entry in entries do
		roll -= entry.weight
		if roll < 0 then
			return entry.id
		end
	end
	return entries[#entries].id
end

function GuestGenerator.rollMutation(rng: Random): Types.MutationId
	for _, id in MutationConfig.RollOrder do
		if rng:NextNumber() < MutationConfig.Mutations[id].SpawnChance then
			return id
		end
	end
	return "None"
end

function GuestGenerator.pickAnomaly(rng: Random, rarity: Types.RarityId): Types.AnomalyDef
	local candidates = {}
	for _, def in AnomalyConfig.List do
		if def.Rarity == rarity then
			table.insert(candidates, def)
		end
	end
	return pick(rng, candidates)
end

-- Registre : (size - 1) autres noms + le nom à inclure (s'il y en a un), mélangés
local function buildRegistry(rng: Random, includeName: string?, excludeName: string): { string }
	local size = GuestConfig.RegistrySize
	local names: { string } = {}
	local used: { [string]: boolean } = { [excludeName] = true }
	if includeName then
		table.insert(names, includeName)
		used[includeName] = true
	end
	local attempts = 0
	while #names < size and attempts < 200 do
		attempts += 1
		local name = randomName(rng)
		if not used[name] then
			used[name] = true
			table.insert(names, name)
		end
	end
	shuffle(rng, names)
	return names
end

function GuestGenerator.generate(rng: Random, options: Options?): Types.GuestProfile
	local opts: Options = options or {}
	local name = randomName(rng)
	local appearance = randomAppearance(rng)

	local isAnomaly
	if opts.ForceAnomalyId ~= nil then
		isAnomaly = true
	elseif opts.ForceAnomaly ~= nil then
		isAnomaly = opts.ForceAnomaly
	else
		isAnomaly = rng:NextNumber() < (opts.AnomalyChance or GuestConfig.AnomalyChance)
	end

	if not isAnomaly then
		return {
			Name = name,
			IsAnomaly = false,
			AnomalyId = nil,
			Mutation = "None",
			Appearance = appearance,
			PhotoAppearance = table.clone(appearance),
			Registry = buildRegistry(rng, name, name),
			Clues = {},
			Temperature = normalTemperature(rng),
		}
	end

	local def
	if opts.ForceAnomalyId and AnomalyConfig.ById[opts.ForceAnomalyId] then
		def = AnomalyConfig.ById[opts.ForceAnomalyId]
	else
		def = GuestGenerator.pickAnomaly(rng, GuestGenerator.rollRarity(rng, opts.RarityLuck))
	end
	local rarity = RarityConfig[def.Rarity]

	-- Choix des indices parmi ceux possibles pour cette anomalie
	local pool = table.clone(def.Clues)
	shuffle(rng, pool)
	local clues: { [Types.ClueType]: Types.ClueStrength } = {}
	for i = 1, math.min(rarity.ClueCount, #pool) do
		clues[pool[i]] = if rng:NextNumber() < rarity.SubtleChance then "Subtle" else "Strong"
	end
	-- Indice caché en plus (seulement visible avec l'outil correspondant)
	if rng:NextNumber() < rarity.HiddenClueChance then
		clues[pick(rng, HIDDEN_CLUES)] = "Strong"
	end

	-- Photo d'identité
	local photo = table.clone(appearance)
	if clues.Photo == "Strong" then
		photo.Skin = differentColor(rng, GuestConfig.SkinTones, appearance.Skin)
		photo.Shirt = differentColor(rng, GuestConfig.ClothColors, appearance.Shirt)
	elseif clues.Photo == "Subtle" then
		photo.Pants = differentColor(rng, GuestConfig.ClothColors, appearance.Pants)
	end

	-- Registre des réservations
	local registryName: string?
	if clues.Registry == "Strong" then
		registryName = nil -- son nom n'y est pas
	elseif clues.Registry == "Subtle" then
		registryName = GuestGenerator.misspell(rng, name) -- presque son nom
	else
		registryName = name
	end

	return {
		Name = name,
		IsAnomaly = true,
		AnomalyId = def.Id,
		Mutation = GuestGenerator.rollMutation(rng),
		Appearance = appearance,
		PhotoAppearance = photo,
		Registry = buildRegistry(rng, registryName, name),
		Clues = clues,
		Temperature = if clues.Thermal then coldTemperature(rng) else normalTemperature(rng),
	}
end

return GuestGenerator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">IncomeCalculator</string>
            <string name="Source"><![CDATA[--!strict
-- Calcul du revenu par seconde d'un joueur. Module pur, testable.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Types = require(Shared:WaitForChild("Types"))
local AnomalyConfig = require(Config:WaitForChild("AnomalyConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))

local IncomeCalculator = {}

-- Revenu d'une seule anomalie (sans les multiplicateurs du joueur)
function IncomeCalculator.anomalyIncome(anomalyId: string, mutation: Types.MutationId): number
	local def = AnomalyConfig.ById[anomalyId]
	if not def then
		return 0
	end
	local mutationDef = MutationConfig.Mutations[mutation]
	local multiplier = if mutationDef then mutationDef.IncomeMultiplier else 1
	return def.Income * multiplier
end

-- Revenu total : somme des anomalies placées dans une cellule x multiplicateur
function IncomeCalculator.total(anomalies: { [string]: Types.OwnedAnomaly }, multiplier: number): number
	local sum = 0
	for _, owned in anomalies do
		if owned.Cell > 0 then
			sum += IncomeCalculator.anomalyIncome(owned.Id, owned.Mutation)
		end
	end
	return sum * multiplier
end

return IncomeCalculator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Construit la carte placeholder : une place centrale et 6 hôtels (3 de chaque côté).
-- Si un dossier Workspace.Map existe déjà (carte faite à la main), on ne fait rien.
--
-- Pour remplacer un hôtel par un vrai modèle plus tard, garder ces noms :
--   Hotel{n} (attribut HotelIndex)
--     GuestSpawn, GuestSpot, GuestExit, OwnerSpawn, Lobby  (repères invisibles)
--     DoorBarrier, Sign (SurfaceGui > OwnerLabel)
--     Cells > Cell{n} > Pad, Spot, Label (SurfaceGui > Text)

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("GameConfig"))

-- Dimensions (studs)
local HOTEL_SIZE = 56
local WALL_HEIGHT = 16
local DOOR_WIDTH = 12
local HOTEL_SPACING = 70
local HOTEL_DISTANCE = 100 -- distance entre le centre de la place et le centre d'un hôtel
local CELL_WIDTH = 6.5

local MapBuilder = {}

local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

-- Repère invisible (position où quelque chose doit apparaître)
local function makeMarker(name: string, cframe: CFrame, parent: Instance): Part
	return makePart({
		Name = name,
		Size = Vector3.new(1, 1, 1),
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = parent,
	})
end

-- Une cellule de confinement. « local » = repère de l'hôtel.
local function buildCell(index: number, origin: CFrame, localCFrame: CFrame, parent: Instance)
	local cell = Instance.new("Model")
	cell.Name = `Cell{index}`
	cell:SetAttribute("CellIndex", index)

	local cf = origin * localCFrame -- l'avant de la cellule (ouverture) = LookVector

	local pad = makePart({
		Name = "Pad",
		Size = Vector3.new(CELL_WIDTH - 0.5, 0.4, CELL_WIDTH - 0.5),
		CFrame = cf * CFrame.new(0, 0.2, 0),
		Color = Color3.fromRGB(60, 60, 70),
		Material = Enum.Material.DiamondPlate,
		Parent = cell,
	})

	-- Vitre décorative (traversable, pour le futur vol)
	makePart({
		Name = "Glass",
		Size = Vector3.new(CELL_WIDTH - 0.5, 8, 0.3),
		CFrame = cf * CFrame.new(0, 4.4, -(CELL_WIDTH / 2 - 0.4)),
		Color = Color3.fromRGB(150, 220, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.75,
		CanCollide = false,
		CastShadow = false,
		Parent = cell,
	})

	-- Où l'anomalie se tient : sur le pad, tournée vers l'ouverture
	makeMarker("Spot", cf * CFrame.new(0, 0.4, 0), cell)

	-- Panneau au-dessus de la vitre (nom, rareté, revenu). Un panneau fixe
	-- plutôt qu'une étiquette flottante : les 16 textes ne se chevauchent pas.
	local sign = makePart({
		Name = "Label",
		Size = Vector3.new(CELL_WIDTH - 0.5, 2, 0.2),
		CFrame = cf * CFrame.new(0, 9.5, -(CELL_WIDTH / 2 - 0.4)),
		Color = Color3.fromRGB(20, 15, 25),
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = cell,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front -- côté ouverture de la cellule
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 50
	surface.Parent = sign

	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.TextScaled = true
	text.Font = Enum.Font.GothamBold
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Text = ""
	text.Parent = surface

	cell.PrimaryPart = pad
	cell.Parent = parent
end

local function buildHotel(index: number, origin: CFrame, parent: Instance)
	local hotel = Instance.new("Model")
	hotel.Name = `Hotel{index}`
	hotel:SetAttribute("HotelIndex", index)

	local half = HOTEL_SIZE / 2
	local wallColor = Color3.fromRGB(92, 64, 80)

	local floor = makePart({
		Name = "Floor",
		Size = Vector3.new(HOTEL_SIZE, 1, HOTEL_SIZE),
		CFrame = origin * CFrame.new(0, 0.5, 0),
		Color = Color3.fromRGB(105, 64, 40),
		Material = Enum.Material.WoodPlanks,
		Parent = hotel,
	})

	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = hotel
	local function wall(name: string, size: Vector3, localPos: Vector3)
		makePart({
			Name = name,
			Size = size,
			CFrame = origin * CFrame.new(localPos),
			Color = wallColor,
			Material = Enum.Material.Brick,
			Parent = walls,
		})
	end
	local y = 1 + WALL_HEIGHT / 2
	wall("Back", Vector3.new(HOTEL_SIZE, WALL_HEIGHT, 1), Vector3.new(0, y, -half))
	wall("Left", Vector3.new(1, WALL_HEIGHT, HOTEL_SIZE), Vector3.new(-half, y, 0))
	wall("Right", Vector3.new(1, WALL_HEIGHT, HOTEL_SIZE), Vector3.new(half, y, 0))
	-- Façade avec une ouverture pour la porte (avant = +Z local, vers la place)
	local sideWidth = (HOTEL_SIZE - DOOR_WIDTH) / 2
	wall("FrontLeft", Vector3.new(sideWidth, WALL_HEIGHT, 1), Vector3.new(-(DOOR_WIDTH + sideWidth) / 2, y, half))
	wall("FrontRight", Vector3.new(sideWidth, WALL_HEIGHT, 1), Vector3.new((DOOR_WIDTH + sideWidth) / 2, y, half))
	wall("FrontTop", Vector3.new(DOOR_WIDTH, 4, 1), Vector3.new(0, 1 + WALL_HEIGHT - 2, half))

	-- Barrière de la porte (verrou de base, utilisée à l'étape 7)
	makePart({
		Name = "DoorBarrier",
		Size = Vector3.new(DOOR_WIDTH, WALL_HEIGHT - 4, 1),
		CFrame = origin * CFrame.new(0, 1 + (WALL_HEIGHT - 4) / 2, half),
		Color = Color3.fromRGB(255, 50, 50),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = hotel,
	})

	-- Comptoir de la réception
	makePart({
		Name = "Counter",
		Size = Vector3.new(14, 4, 2.5),
		CFrame = origin * CFrame.new(0, 3, 12),
		Color = Color3.fromRGB(60, 35, 25),
		Material = Enum.Material.Wood,
		Parent = hotel,
	})

	-- Repères (le client regarde le comptoir, donc vers -Z local)
	local facingCounter = CFrame.identity -- LookVector = -Z local
	makeMarker("GuestSpawn", origin * CFrame.new(0, 1, half + 8) * facingCounter, hotel)
	-- Assez loin du comptoir pour que la caméra se glisse entre les deux
	makeMarker("GuestSpot", origin * CFrame.new(0, 1, 19.5) * facingCounter, hotel)
	makeMarker("GuestExit", origin * CFrame.new(half + 10, 1, half + 8), hotel)
	makeMarker("OwnerSpawn", origin * CFrame.new(0, 1, 7) * CFrame.Angles(0, math.pi, 0), hotel)
	local lobby = makeMarker("Lobby", origin * CFrame.new(0, 1, 0), hotel)
	lobby.Size = Vector3.new(40, 1, 16) -- zone où erre une anomalie échappée

	-- Lumière au-dessus du client : rend son ombre bien visible
	local lightHolder = makeMarker("GuestLight", origin * CFrame.new(0, 12, 20), hotel)
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 2
	light.Shadows = true
	light.Parent = lightHolder

	-- Enseigne au-dessus de la porte, lisible depuis la place
	local sign = makePart({
		Name = "Sign",
		Size = Vector3.new(24, 4, 0.5),
		CFrame = CFrame.lookAt(
			(origin * CFrame.new(0, WALL_HEIGHT + 3.5, half + 0.6)).Position,
			(origin * CFrame.new(0, WALL_HEIGHT + 3.5, half + 10)).Position
		),
		Color = Color3.fromRGB(30, 20, 30),
		Material = Enum.Material.SmoothPlastic,
		Parent = hotel,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 40
	surface.Parent = sign
	local signText = Instance.new("TextLabel")
	signText.Name = "OwnerLabel"
	signText.Size = UDim2.fromScale(1, 1)
	signText.BackgroundTransparency = 1
	signText.TextScaled = true
	signText.Font = Enum.Font.Creepster
	signText.TextColor3 = Color3.fromRGB(255, 220, 120)
	signText.Text = "Hôtel libre"
	signText.Parent = surface

	-- Cellules : 8 le long du mur du fond, puis 4 sur chaque côté
	local cells = Instance.new("Folder")
	cells.Name = "Cells"
	cells.Parent = hotel
	local cellIndex = 0
	local backZ = -half + CELL_WIDTH / 2 + 0.5
	for i = 0, 7 do
		cellIndex += 1
		local x = -half + 1 + CELL_WIDTH / 2 + i * CELL_WIDTH
		-- Ouverture vers +Z (vers le centre de l'hôtel)
		buildCell(cellIndex, origin, CFrame.new(x, 1, backZ) * CFrame.Angles(0, math.pi, 0), cells)
	end
	for _, side in { -1, 1 } do
		for i = 0, 3 do
			cellIndex += 1
			local x = side * (half - CELL_WIDTH / 2 - 0.5)
			local z = backZ + CELL_WIDTH * (i + 1.5)
			-- Ouverture vers le centre de l'hôtel
			local look = CFrame.lookAt(Vector3.new(x, 1, z), Vector3.new(0, 1, z))
			buildCell(cellIndex, origin, look, cells)
		end
	end
	assert(cellIndex >= GameConfig.MaxCells, "Pas assez d'emplacements de cellules construits")

	hotel.PrimaryPart = floor
	hotel.Parent = parent
end

function MapBuilder.build(): Folder
	local existing = workspace:FindFirstChild("Map")
	if existing and existing:IsA("Folder") then
		return existing
	end

	local map = Instance.new("Folder")
	map.Name = "Map"

	makePart({
		Name = "Ground",
		Size = Vector3.new(700, 2, 700),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(58, 79, 52),
		Material = Enum.Material.Grass,
		Parent = map,
	})
	makePart({
		Name = "Plaza",
		Size = Vector3.new(220, 0.4, 130),
		CFrame = CFrame.new(0, 0.2, 0),
		Color = Color3.fromRGB(110, 110, 115),
		Material = Enum.Material.Cobblestone,
		Parent = map,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.9, 0)
	spawn.Neutral = true
	spawn.Duration = 0 -- pas de bouclier d'apparition
	spawn.Color = Color3.fromRGB(80, 40, 90)
	spawn.Parent = map

	-- Panneau du classement mondial, au bord ouest de la place, tourné vers le centre
	local board = makePart({
		Name = "Leaderboard",
		Size = Vector3.new(26, 16, 1),
		CFrame = CFrame.lookAt(Vector3.new(-104, 9, 0), Vector3.new(0, 9, 0)),
		Color = Color3.fromRGB(25, 18, 30),
		Material = Enum.Material.SmoothPlastic,
		Parent = map,
	})
	local boardGui = Instance.new("SurfaceGui")
	boardGui.Face = Enum.NormalId.Front
	boardGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	boardGui.PixelsPerStud = 30
	boardGui.Parent = board
	local boardTitle = Instance.new("TextLabel")
	boardTitle.Size = UDim2.fromScale(1, 0.16)
	boardTitle.BackgroundTransparency = 1
	boardTitle.TextScaled = true
	boardTitle.Font = Enum.Font.Creepster
	boardTitle.TextColor3 = Color3.fromRGB(255, 220, 120)
	boardTitle.Text = "Meilleurs revenus"
	boardTitle.Parent = boardGui
	local boardLines = Instance.new("TextLabel")
	boardLines.Name = "Lines"
	boardLines.Position = UDim2.fromScale(0.05, 0.18)
	boardLines.Size = UDim2.fromScale(0.9, 0.78)
	boardLines.BackgroundTransparency = 1
	boardLines.TextScaled = true
	boardLines.TextXAlignment = Enum.TextXAlignment.Left
	boardLines.TextYAlignment = Enum.TextYAlignment.Top
	boardLines.Font = Enum.Font.GothamBold
	boardLines.TextColor3 = Color3.new(1, 1, 1)
	boardLines.Text = "Chargement..."
	boardLines.Parent = boardGui

	local hotels = Instance.new("Folder")
	hotels.Name = "Hotels"
	hotels.Parent = map

	-- 3 hôtels au nord (porte vers le sud), 3 au sud (porte vers le nord)
	local perSide = math.ceil(GameConfig.HotelCount / 2)
	for index = 1, GameConfig.HotelCount do
		local north = index <= perSide
		local column = if north then index - 1 else index - perSide - 1
		local x = (column - (perSide - 1) / 2) * HOTEL_SPACING
		local origin
		if north then
			origin = CFrame.new(x, 0, -HOTEL_DISTANCE)
		else
			origin = CFrame.new(x, 0, HOTEL_DISTANCE) * CFrame.Angles(0, math.pi, 0)
		end
		buildHotel(index, origin, hotels)
	end

	-- Ambiance coucher de soleil : un peu inquiétant, mais les ombres restent visibles
	Lighting.ClockTime = 17.6
	Lighting.Brightness = 2

	map.Parent = workspace
	return map
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--!strict
-- Envoie un message à afficher en haut de l'écran d'un joueur.
-- kind : "Info" (blanc), "Good" (vert), "Bad" (rouge), ou une couleur Color3

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Notify = {}

function Notify.send(player: Player, text: string, kind: (string | Color3)?)
	Remotes.getEvent("Notify"):FireClient(player, text, kind or "Info")
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">RigFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Fournit le personnage R15 placeholder utilisé pour les clients et anomalies.
-- Le modèle de base est créé une fois, puis placé dans
-- ReplicatedStorage.Assets.GuestRig (le client s'en sert pour les photos).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RigFactory = {}

local template: Model? = nil

local function getAssetsFolder(): Folder
	local folder = ReplicatedStorage:FindFirstChild("Assets")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Assets"
		folder.Parent = ReplicatedStorage
	end
	return folder :: Folder
end

local function createTemplate(): Model
	-- Un modèle déjà présent (fait à la main) est prioritaire
	local existing = getAssetsFolder():FindFirstChild("GuestRig")
	if existing and existing:IsA("Model") then
		return existing
	end

	local description = Instance.new("HumanoidDescription")
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		error(`[RigFactory] Impossible de créer le personnage R15 : {result}`)
	end
	local rig = result :: Model
	rig.Name = "GuestRig"

	-- On retire scripts et vêtements : couleurs pilotées par RigAppearance
	for _, descendant in rig:GetDescendants() do
		if
			descendant:IsA("BaseScript")
			or descendant:IsA("BodyColors")
			or descendant:IsA("Clothing")
			or descendant:IsA("ShirtGraphic")
		then
			descendant:Destroy()
		end
	end

	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end

	rig.Parent = getAssetsFolder()
	return rig
end

-- Renvoie une copie neuve du personnage de base (peut attendre au 1er appel)
local creating = false

function RigFactory.newRig(): Model
	-- Si un autre thread est déjà en train de le créer, on attend
	while creating do
		task.wait()
	end
	if not template then
		creating = true
		local ok, result = pcall(createTemplate)
		creating = false
		if not ok then
			error(result)
		end
		template = result
	end
	return (template :: Model):Clone()
end

return RigFactory
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">AnomalyService</string>
            <string name="Source"><![CDATA[--!strict
-- Gère les anomalies capturées : placement dans les cellules, modèles 3D
-- affichés dans l'hôtel, catalogue des anomalies découvertes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")

local Types = require(Shared:WaitForChild("Types"))
local AnomalyConfig = require(Config:WaitForChild("AnomalyConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local RigAppearance = require(Shared:WaitForChild("Util"):WaitForChild("RigAppearance"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local IncomeCalculator = require(Server:WaitForChild("Modules"):WaitForChild("IncomeCalculator"))
local RigFactory = require(Server:WaitForChild("Modules"):WaitForChild("RigFactory"))
local HotelService = require(script.Parent:WaitForChild("HotelService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local AnomalyService = {}

-- (player) : la liste des anomalies du joueur a changé (revenu à recalculer)
AnomalyService.AnomaliesChanged = Signal.new()
-- (player, anomalyId) : première capture de cette anomalie (catalogue)
AnomalyService.Discovered = Signal.new()
-- (thief, owner, uid) : un joueur a activé « Voler » sur une anomalie
AnomalyService.StealRequested = Signal.new()

-- Modèles affichés : models[player][uid] = Model
local models: { [Player]: { [string]: Model } } = {}

local function getCell(hotel: Model, cellIndex: number): Model?
	local cells = hotel:FindFirstChild("Cells")
	local cell = cells and cells:FindFirstChild(`Cell{cellIndex}`)
	return if cell and cell:IsA("Model") then cell else nil
end

local function getCellLabel(cell: Model): TextLabel?
	local label = cell:FindFirstChild("Text", true)
	return if label and label:IsA("TextLabel") then label else nil
end

-- Nombre de cellules utilisables par le joueur
function AnomalyService.GetCellCapacity(player: Player): number
	local data = PlayerDataService.GetData(player)
	if not data then
		return 0
	end
	-- Bonus du gamepass « +3 cellules » (attribut posé par MonetizationService)
	local bonus = if player:GetAttribute("Pass_ExtraCells") then MonetizationConfig.GamePasses.ExtraCells.Cells else 0
	return math.min(GameConfig.MaxCells, data.CellsUnlocked + bonus)
end

-- Premier numéro de cellule libre, ou nil si tout est plein
local function findFreeCell(data: any, capacity: number): number?
	local used: { [number]: boolean } = {}
	for _, owned in data.Anomalies do
		used[owned.Cell] = true
	end
	for index = 1, capacity do
		if not used[index] then
			return index
		end
	end
	return nil
end

-- Met à jour l'aspect des cellules vides / verrouillées
local function refreshCellVisuals(player: Player, hotel: Model)
	local data = PlayerDataService.GetData(player)
	if not data then
		return
	end
	local capacity = AnomalyService.GetCellCapacity(player)
	local occupied: { [number]: boolean } = {}
	for _, owned in data.Anomalies do
		occupied[owned.Cell] = true
	end
	for index = 1, GameConfig.MaxCells do
		local cell = getCell(hotel, index)
		if cell then
			local pad = cell:FindFirstChild("Pad")
			local label = getCellLabel(cell)
			local unlocked = index <= capacity
			if pad and pad:IsA("BasePart") then
				pad.Color = if unlocked then Color3.fromRGB(70, 90, 110) else Color3.fromRGB(35, 35, 40)
			end
			if label and not occupied[index] then
				label.Text = if unlocked then "Cellule libre" else "🔒 Verrouillée"
				label.TextColor3 = Color3.new(1, 1, 1)
			end
		end
	end
end

local function resetCellVisuals(hotel: Model)
	for index = 1, GameConfig.MaxCells do
		local cell = getCell(hotel, index)
		if cell then
			local label = getCellLabel(cell)
			if label then
				label.Text = ""
			end
			local pad = cell:FindFirstChild("Pad")
			if pad and pad:IsA("BasePart") then
				pad.Color = Color3.fromRGB(60, 60, 70)
			end
		end
	end
end

-- Personnage de l'anomalie sous sa vraie forme (couleurs, mutation, yeux)
function AnomalyService.BuildRig(anomalyId: string, mutationId: Types.MutationId): Model
	local def = AnomalyConfig.ById[anomalyId]
	local rig = RigFactory.newRig()
	RigAppearance.apply(rig, def.TrueForm)
	local mutation = MutationConfig.Mutations[mutationId]
	if mutation and mutation.Color and mutation.Material then
		RigAppearance.applyMaterial(rig, mutation.Color, mutation.Material)
	end
	RigAppearance.addGlowingEyes(rig, def.EyeColor, 0.25)
	RigAppearance.setCastShadow(rig, false)
	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CanCollide = false
		end
	end
	return rig
end

-- Crée le modèle 3D de l'anomalie dans sa cellule (sa vraie forme)
local function spawnModel(player: Player, hotel: Model, uid: string, owned: Types.OwnedAnomaly)
	local def = AnomalyConfig.ById[owned.Id]
	local cell = getCell(hotel, owned.Cell)
	local spot = cell and cell:FindFirstChild("Spot")
	if not def or not cell or not spot or not spot:IsA("BasePart") then
		return
	end

	local rig = AnomalyService.BuildRig(owned.Id, owned.Mutation)
	rig.Name = `Anomaly_{uid}`
	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
	RigAppearance.placeOnFloor(rig, spot.CFrame)
	rig.Parent = cell

	-- Invite « Voler », visible seulement des autres joueurs (voir PromptController)
	local root = rig:FindFirstChild("HumanoidRootPart")
	if root then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Voler"
		prompt.ObjectText = def.DisplayName
		prompt.HoldDuration = ShopConfig.Steal.HoldDuration
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("ExceptUserId", player.UserId)
		prompt.Triggered:Connect(function(thief)
			AnomalyService.StealRequested:Fire(thief, player, uid)
		end)
		prompt.Parent = root
	end

	-- Étiquette : nom, rareté, mutation, revenu
	local label = getCellLabel(cell)
	if label then
		local rarity = RarityConfig[def.Rarity]
		local income = IncomeCalculator.anomalyIncome(owned.Id, owned.Mutation)
		local mutation = MutationConfig.Mutations[owned.Mutation]
		local mutationText = if owned.Mutation ~= "None" and mutation then ` [{mutation.DisplayName}]` else ""
		label.Text = `{def.DisplayName}{mutationText}\n{rarity.DisplayName} • {Format.money(income)}/s`
		label.TextColor3 = rarity.Color
	end

	local playerModels = models[player]
	if playerModels then
		playerModels[uid] = rig
	end
end

-- Vérifie les données au chargement : anomalies inconnues, cellules en double
local function repairData(player: Player, data: any)
	-- Limite absolue (et pas la capacité actuelle) : la vérification du gamepass
	-- « +3 cellules » peut arriver après, il ne faut pas déplacer ces anomalies
	local capacity = GameConfig.MaxCells
	local used: { [number]: boolean } = {}
	local toPlace: { any } = {}
	for uid, owned in data.Anomalies do
		if not AnomalyConfig.ById[owned.Id] then
			warn(`[AnomalyService] Anomalie inconnue retirée : {owned.Id}`)
			data.Anomalies[uid] = nil
		elseif owned.Cell < 1 or owned.Cell > capacity or used[owned.Cell] then
			table.insert(toPlace, owned)
		else
			used[owned.Cell] = true
		end
	end
	for _, owned in toPlace do
		owned.Cell = 0
		owned.Cell = findFreeCell(data, AnomalyService.GetCellCapacity(player)) or 0
	end
end

local function onHotelAssigned(player: Player, hotel: Model)
	local data = PlayerDataService.GetData(player)
	if not data then
		return
	end
	models[player] = {}
	repairData(player, data)
	refreshCellVisuals(player, hotel)
	for uid, owned in data.Anomalies do
		if owned.Cell > 0 then
			spawnModel(player, hotel, uid, owned)
		end
	end
	AnomalyService.AnomaliesChanged:Fire(player)
end

local function onHotelReleased(player: Player, hotel: Model)
	local playerModels = models[player]
	if playerModels then
		for _, model in playerModels do
			model:Destroy()
		end
	end
	models[player] = nil
	resetCellVisuals(hotel)
end

-- Ajoute une anomalie capturée. Renvoie le numéro de cellule, ou nil si
-- toutes les cellules sont pleines (l'anomalie n'est alors pas ajoutée).
function AnomalyService.AddAnomaly(player: Player, anomalyId: string, mutation: Types.MutationId): number?
	local data = PlayerDataService.GetData(player)
	local hotel = HotelService.GetHotel(player)
	if not data or not AnomalyConfig.ById[anomalyId] then
		return nil
	end
	-- Elle compte dans le catalogue même si elle ne rentre pas
	if not data.Discovered[anomalyId] then
		data.Discovered[anomalyId] = true
		AnomalyService.Discovered:Fire(player, anomalyId)
	end

	local cellIndex = findFreeCell(data, AnomalyService.GetCellCapacity(player))
	if not cellIndex then
		return nil
	end

	-- Préfixe « a » : la clé reste du texte une fois sauvegardée
	local uid = `a{data.NextAnomalyUid}`
	data.NextAnomalyUid += 1
	local owned: Types.OwnedAnomaly = { Id = anomalyId, Mutation = mutation, Cell = cellIndex }
	data.Anomalies[uid] = owned

	if hotel then
		spawnModel(player, hotel, uid, owned)
	end
	AnomalyService.AnomaliesChanged:Fire(player)
	return cellIndex
end

-- Anomalie possédée (ou nil)
function AnomalyService.GetOwned(player: Player, uid: string): Types.OwnedAnomaly?
	local data = PlayerDataService.GetData(player)
	return if data then data.Anomalies[uid] else nil
end

function AnomalyService.HasFreeCell(player: Player): boolean
	local data = PlayerDataService.GetData(player)
	return data ~= nil and findFreeCell(data, AnomalyService.GetCellCapacity(player)) ~= nil
end

-- Modèle 3D de l'anomalie dans sa cellule (ou nil)
function AnomalyService.GetModel(player: Player, uid: string): Model?
	local playerModels = models[player]
	return if playerModels then playerModels[uid] else nil
end

-- Retire le modèle de la cellule (pendant un vol) sans toucher aux données
function AnomalyService.HideModel(player: Player, uid: string)
	local playerModels = models[player]
	local model = playerModels and playerModels[uid]
	if model and playerModels then
		model:Destroy()
		playerModels[uid] = nil
	end
end

-- Remet le modèle dans sa cellule (vol raté)
function AnomalyService.ShowModel(player: Player, uid: string)
	local owned = AnomalyService.GetOwned(player, uid)
	local hotel = HotelService.GetHotel(player)
	if owned and hotel and owned.Cell > 0 and not AnomalyService.GetModel(player, uid) then
		spawnModel(player, hotel, uid, owned)
	end
end

-- Supprime définitivement une anomalie (vol réussi). Renvoie ce qui a été retiré.
function AnomalyService.RemoveAnomaly(player: Player, uid: string): Types.OwnedAnomaly?
	local data = PlayerDataService.GetData(player)
	local owned = data and data.Anomalies[uid]
	if not data or not owned then
		return nil
	end
	AnomalyService.HideModel(player, uid)
	data.Anomalies[uid] = nil
	local hotel = HotelService.GetHotel(player)
	if hotel then
		refreshCellVisuals(player, hotel)
	end
	AnomalyService.AnomaliesChanged:Fire(player)
	return owned
end

-- Rafraîchit l'aspect des cellules (après l'achat d'une cellule)
function AnomalyService.RefreshCells(player: Player)
	local hotel = HotelService.GetHotel(player)
	if hotel then
		refreshCellVisuals(player, hotel)
	end
end

function AnomalyService.Init(_self: typeof(AnomalyService))
	HotelService.HotelAssigned:Connect(onHotelAssigned)
	HotelService.HotelReleased:Connect(onHotelReleased)
end

return AnomalyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">CatalogService</string>
            <string name="Source"><![CDATA[--!strict
-- Catalogue des anomalies (Anomalydex) : publie les anomalies découvertes
-- (attributs Disc_<Id>) et verse les récompenses de paliers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local AnomalyConfig = require(Config:WaitForChild("AnomalyConfig"))
local CatalogConfig = require(Config:WaitForChild("CatalogConfig"))
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("Format"))
local Notify = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Modules"):WaitForChild("Notify"))
local AnomalyService = require(script.Parent:WaitForChild("AnomalyService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local CatalogService = {}

local function countDiscovered(data: any): number
	local count = 0
	for _, def in AnomalyConfig.List do
		if data.Discovered[def.Id] then
			count += 1
		end
	end
	return count
end

-- Publie le catalogue et verse les récompenses pas encore reçues
local function refresh(player: Player)
	local data = PlayerDataService.GetData(player)
	if not data then
		return
	end
	for _, def in AnomalyConfig.List do
		player:SetAttribute(`Disc_{def.Id}`, data.Discovered[def.Id] == true)
	end
	local count = countDiscovered(data)
	player:SetAttribute("DiscoveredCount", count)
	for _, reward in CatalogConfig.Rewards do
		local key = tostring(reward.Count)
		if count >= reward.Count and not data.CatalogRewards[key] then
			data.CatalogRewards[key] = true
			PlayerDataService.AddMoney(player, reward.Money)
			Notify.send(player, `Catalogue : {reward.Count} anomalies découvertes ! +{Format.money(reward.Money)}`, "Good")
		end
	end
end

function CatalogService.Init(_self: typeof(CatalogService))
	PlayerDataService.DataLoaded:Connect(refresh)
	AnomalyService.Discovered:Connect(refresh)
end

return CatalogService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">DebugService</string>
            <string name="Source"><![CDATA[--!strict
-- Commandes de test, à taper dans le chat (Studio, ou UserId dans GameConfig.AdminUserIds) :
--   !argent 1000              donne de l'argent
--   !anomalie Doppelganger    ajoute une anomalie (mutation optionnelle : Golden, Neon)
--   !prochain anomalie        le prochain client sera une anomalie
--   !prochain normal          le prochain client sera un vrai client
--   !prochain TheOwner        le prochain client sera cette anomalie précise
--   !pass DoubleMoney         simule un gamepass (DoubleMoney ou ExtraCells), jusqu'au départ
--   !chance                   lance une « Nuit chanceuse » de 10 min
--   !temps 10                 accélère le temps x10 (revenus et clients) ; !temps 1 pour revenir
--   !tuto                     relance le tutoriel
--   !reset                    remet tes données à zéro

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local AnomalyConfig = require(Config:WaitForChild("AnomalyConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local MutationConfig = require(Config:WaitForChild("MutationConfig"))
local Notify = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Modules"):WaitForChild("Notify"))
local AnomalyService = require(script.Parent:WaitForChild("AnomalyService"))
local GuestService = require(script.Parent:WaitForChild("GuestService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local DebugService = {}

local function isAllowed(player: Player): boolean
	if GameConfig.DebugInStudio and RunService:IsStudio() then
		return true
	end
	return table.find(GameConfig.AdminUserIds, player.UserId) ~= nil
end

local commands: { [string]: (player: Player, args: { string }) -> () } = {}

commands.argent = function(player, args)
	local amount = tonumber(args[1])
	if not amount then
		Notify.send(player, "Usage : !argent 1000", "Bad")
		return
	end
	PlayerDataService.AddMoney(player, amount)
	Notify.send(player, `+{amount} $ (debug)`, "Good")
end

commands.anomalie = function(player, args)
	local id = args[1]
	local mutation = args[2] or "None"
	if not id or not AnomalyConfig.ById[id] then
		local ids = {}
		for _, def in AnomalyConfig.List do
			table.insert(ids, def.Id)
		end
		Notify.send(player, "Ids : " .. table.concat(ids, ", "), "Bad")
		return
	end
	if not MutationConfig.Mutations[mutation :: any] then
		Notify.send(player, "Mutation : None, Golden ou Neon", "Bad")
		return
	end
	local cell = AnomalyService.AddAnomaly(player, id, mutation :: any)
	Notify.send(player, if cell then `Ajoutée en cellule {cell}` else "Cellules pleines", "Info")
end

commands.prochain = function(player, args)
	local what = args[1]
	if what == "anomalie" then
		GuestService.ForceNext(player, { ForceAnomaly = true })
	elseif what == "normal" then
		GuestService.ForceNext(player, { ForceAnomaly = false })
	elseif what and AnomalyConfig.ById[what] then
		GuestService.ForceNext(player, { ForceAnomalyId = what })
	else
		Notify.send(player, "Usage : !prochain anomalie | normal | <Id>", "Bad")
		return
	end
	Notify.send(player, "Prochain client réglé (debug)", "Info")
end

commands.pass = function(player, args)
	local name = args[1]
	if name ~= "DoubleMoney" and name ~= "ExtraCells" then
		Notify.send(player, "Usage : !pass DoubleMoney | ExtraCells", "Bad")
		return
	end
	player:SetAttribute(`Pass_{name}`, true)
	AnomalyService.RefreshCells(player)
	AnomalyService.AnomaliesChanged:Fire(player)
	Notify.send(player, `Gamepass {name} simulé (debug)`, "Good")
end

commands.chance = function(player)
	local data = PlayerDataService.GetData(player)
	if data then
		data.LuckyUntil = os.time() + 600
		player:SetAttribute("LuckyUntil", data.LuckyUntil)
		Notify.send(player, "Nuit chanceuse lancée (debug)", "Good")
	end
end

commands.temps = function(player, args)
	local scale = tonumber(args[1])
	if not scale or scale < 1 or scale > 100 then
		Notify.send(player, "Usage : !temps 10 (entre 1 et 100)", "Bad")
		return
	end
	player:SetAttribute("TimeScale", if scale == 1 then nil else scale)
	Notify.send(player, `Temps x{scale} (debug)`, "Good")
end

commands.tuto = function(player)
	local data = PlayerDataService.GetData(player)
	if data then
		data.TutorialDone = false
		player:SetAttribute("TutorialDone", false)
		GuestService.ForceNext(player, { ForceAnomalyId = "Doppelganger" })
		Notify.send(player, "Tutoriel relancé (debug)", "Good")
	end
end

commands.reset = function(player)
	PlayerDataService.ResetData(player)
end

local function onChatted(player: Player, message: string)
	if string.sub(message, 1, 1) ~= "!" or not isAllowed(player) then
		return
	end
	local words = string.split(string.sub(message, 2), " ")
	local name = string.lower(table.remove(words, 1) or "")
	local command = commands[name]
	if command then
		print(`[Debug] {player.Name} : !{name} {table.concat(words, " ")}`)
		command(player, words)
	end
end

local function onPlayerAdded(player: Player)
	player.Chatted:Connect(function(message)
		onChatted(player, message)
	end)
end

function DebugService.Start(_self: typeof(DebugService))
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
end

return DebugService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">GuestService</string>
            <string name="Source"><![CDATA[--!strict
-- Réception : fait arriver des clients au comptoir de chaque hôtel occupé.
-- Le propriétaire les inspecte puis choisit « Donner la clé » ou « Capturer ».
-- Le serveur garde secret qui est une anomalie et décide du résultat.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local TweenService = game:GetService("TweenService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Modules = Server:WaitForChild("Modules")

local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local AnomalyConfig = require(Config:WaitForChild("AnomalyConfig"))
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local GuestConfig = require(Config:WaitForChild("GuestConfig"))
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))
local RigAppearance = require(Shared:WaitForChild("Util"):WaitForChild("RigAppearance"))
local GuestGenerator = require(Modules:WaitForChild("GuestGenerator"))
local IncomeCalculator = require(Modules:WaitForChild("IncomeCalculator"))
local Notify = require(Modules:WaitForChild("Notify"))
local RigFactory = require(Modules:WaitForChild("RigFactory"))
local CollisionGroups = require(Modules:WaitForChild("CollisionGroups"))
local Analytics = require(Modules:WaitForChild("Analytics"))
local RateLimiter = require(Server:WaitForChild("Util"):WaitForChild("RateLimiter"))
local AnomalyService = require(script.Parent:WaitForChild("AnomalyService"))
local HotelService = require(script.Parent:WaitForChild("HotelService"))
local IncomeService = require(script.Parent:WaitForChild("IncomeService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

-- Distance max entre le joueur et le client pour décider (anti-triche)
local MAX_DECISION_DISTANCE = 30
local GUEST_WALK_SPEED = 12

type Guest = {
	token: number,
	profile: Types.GuestProfile,
	model: Model,
	state: "Arriving" | "Waiting" | "Decided",
	decision: string?,
}

type Session = {
	player: Player,
	hotel: Model,
	active: boolean,
	guest: Guest?,
	extraModels: { [Model]: boolean }, -- clients qui partent, anomalies qui errent
	forceNext: GuestGenerator.Options?, -- prochain client imposé (debug)
}

local GuestService = {}

local rng = Random.new()
local sessions: { [Player]: Session } = {}
local nextToken = 0
local promptLimiter = RateLimiter.new(3, 1)
local decisionLimiter = RateLimiter.new(4, 1)

local guestsFolder: Folder

local function getMarker(hotel: Model, name: string): BasePart
	local marker = hotel:FindFirstChild(name)
	assert(marker and marker:IsA("BasePart"), `Repère manquant dans {hotel.Name} : {name}`)
	return marker
end

local function getRoot(model: Model): BasePart?
	local root = model:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Fait marcher un personnage jusqu'à une position (avec délai max)
local function walkTo(model: Model, position: Vector3, timeout: number): boolean
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or not model.Parent then
		return false
	end
	local reached = false
	local connection = humanoid.MoveToFinished:Connect(function(success)
		reached = success
	end)
	humanoid:MoveTo(position)
	local elapsed = 0
	while not reached and elapsed < timeout and model.Parent do
		elapsed += task.wait(0.1)
	end
	connection:Disconnect()
	return reached
end

local function destroyExtra(session: Session, model: Model)
	session.extraModels[model] = nil
	model:Destroy()
end

local function setAnchored(model: Model, anchored: boolean)
	local root = getRoot(model)
	if root then
		root.Anchored = anchored
	end
end

local function removePrompt(model: Model)
	local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		prompt:Destroy()
	end
end

-- Crée le modèle du client avec ses indices visibles (yeux, ombre)
local function buildGuestModel(session: Session, profile: Types.GuestProfile): Model
	local rig = RigFactory.newRig()
	rig.Name = "Guest"
	RigAppearance.apply(rig, profile.Appearance)

	local eyes = profile.Clues.Eyes
	if eyes == "Strong" then
		RigAppearance.addGlowingEyes(rig, Color3.fromRGB(255, 40, 40), 0.28)
	elseif eyes == "Subtle" then
		RigAppearance.addGlowingEyes(rig, Color3.fromRGB(255, 170, 60), 0.12)
	end
	if profile.Clues.Shadow then
		RigAppearance.setCastShadow(rig, false)
	end

	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = GUEST_WALK_SPEED
	end
	rig:SetAttribute("OwnerUserId", session.player.UserId)
	-- Les clients traversent la barrière de verrou
	CollisionGroups.assign(rig, CollisionGroups.GUESTS):Disconnect()

	RigAppearance.placeOnFloor(rig, getMarker(session.hotel, "GuestSpawn").CFrame)
	rig.Parent = guestsFolder

	-- Le serveur contrôle la physique du client (empêche les joueurs de le déplacer)
	local root = getRoot(rig)
	if root then
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	return rig
end

-- Le client repart (vers l'extérieur, ou dans l'hôtel s'il a eu sa clé)
local function walkAway(session: Session, model: Model, intoHotel: boolean)
	removePrompt(model)
	setAnchored(model, false)
	session.extraModels[model] = true
	task.spawn(function()
		local spot = getMarker(session.hotel, "GuestSpot").CFrame
		if intoHotel then
			-- Contourne le comptoir puis entre dans l'hôtel
			walkTo(model, (spot * CFrame.new(10, 0, 0)).Position, 4)
			walkTo(model, (spot * CFrame.new(10, 0, -14)).Position, 4)
		else
			walkTo(model, getMarker(session.hotel, "GuestSpawn").Position, 5)
			walkTo(model, getMarker(session.hotel, "GuestExit").Position, 5)
		end
		if session.extraModels[model] then
			destroyExtra(session, model)
		end
	end)
end

-- Anomalie capturée : révèle sa vraie forme puis disparaît (elle part en cellule)
local function revealAndVanish(session: Session, model: Model, def: Types.AnomalyDef)
	removePrompt(model)
	session.extraModels[model] = true
	RigAppearance.apply(model, def.TrueForm)
	RigAppearance.addGlowingEyes(model, def.EyeColor, 0.28)
	RigAppearance.setCastShadow(model, false)
	task.spawn(function()
		task.wait(0.6)
		local info = TweenInfo.new(0.8)
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
				TweenService:Create(descendant, info, { Transparency = 1 }):Play()
			elseif descendant:IsA("Decal") then
				TweenService:Create(descendant, info, { Transparency = 1 }):Play()
			end
		end
		task.wait(0.9)
		if session.extraModels[model] then
			destroyExtra(session, model)
		end
	end)
end

-- Anomalie qui s'est infiltrée : elle erre dans le hall pendant la pénalité
local function startWanderer(session: Session, model: Model, def: Types.AnomalyDef)
	removePrompt(model)
	setAnchored(model, false)
	RigAppearance.addGlowingEyes(model, def.EyeColor, 0.28)
	session.extraModels[model] = true
	task.spawn(function()
		local lobby = getMarker(session.hotel, "Lobby")
		local spot = getMarker(session.hotel, "GuestSpot").CFrame
		walkTo(model, (spot * CFrame.new(10, 0, 0)).Position, 4)
		local endsAt = os.clock() + EconomyConfig.EscapedDuration
		while os.clock() < endsAt and session.active and model.Parent do
			local offset = Vector3.new(
				rng:NextNumber(-0.5, 0.5) * lobby.Size.X,
				0,
				rng:NextNumber(-0.5, 0.5) * lobby.Size.Z
			)
			walkTo(model, lobby.CFrame:PointToWorldSpace(offset), 4)
			task.wait(rng:NextNumber(0.5, 2))
		end
		if session.extraModels[model] then
			destroyExtra(session, model)
		end
	end)
end

local function clueList(profile: Types.GuestProfile): { { Type: string, Strength: string } }
	local list = {}
	for clueType, strength in profile.Clues do
		table.insert(list, { Type = clueType, Strength = strength })
	end
	table.sort(list, function(a, b)
		return a.Type < b.Type
	end)
	return list
end

-- Applique la décision (ou l'absence de décision) et prévient le joueur
local function resolve(session: Session, guest: Guest, decision: string)
	local player = session.player
	local profile = guest.profile
	local data = PlayerDataService.GetData(player)
	if not data then
		guest.model:Destroy()
		return
	end
	local income = IncomeService.GetIncome(player)
	local outcome: string
	local details: { [string]: any } = { Clues = clueList(profile), Amount = 0 }

	if profile.IsAnomaly then
		local def = AnomalyConfig.ById[profile.AnomalyId :: string]
		details.AnomalyName = def.DisplayName
		details.Rarity = def.Rarity
		details.Mutation = profile.Mutation

		if decision == "Capture" then
			data.Stats.Captures += 1
			Analytics.first(player, data, "Capture")
			local cell = AnomalyService.AddAnomaly(player, def.Id, profile.Mutation)
			if cell then
				outcome = "Captured"
			else
				outcome = "CapturedSold"
				local amount = IncomeCalculator.anomalyIncome(def.Id, profile.Mutation) * EconomyConfig.FullCellsSellSeconds
				details.Amount = amount
				PlayerDataService.AddMoney(player, amount)
			end
			revealAndVanish(session, guest.model, def)
		else
			outcome = "Escaped"
			data.Stats.Escaped += 1
			IncomeService.ApplyDebuff(player, EconomyConfig.EscapedIncomeMultiplier, EconomyConfig.EscapedDuration)
			startWanderer(session, guest.model, def)
		end
	else
		if decision == "Accept" then
			outcome = "Served"
			local tip = math.max(EconomyConfig.TipBase, math.floor(income * EconomyConfig.TipIncomeSeconds))
			details.Amount = tip
			data.Stats.GuestsServed += 1
			PlayerDataService.AddMoney(player, tip)
			walkAway(session, guest.model, true)
		elseif decision == "Capture" then
			outcome = "WrongCapture"
			local penalty = math.floor(EconomyConfig.WrongCaptureBase + income * EconomyConfig.WrongCaptureIncomeSeconds)
			penalty = math.min(penalty, PlayerDataService.GetMoney(player))
			details.Amount = penalty
			data.Stats.WrongCaptures += 1
			PlayerDataService.AddMoney(player, -penalty)
			walkAway(session, guest.model, false)
		else
			outcome = "Left"
			walkAway(session, guest.model, false)
		end
	end

	Remotes.getEvent("ReceptionResult"):FireClient(player, guest.token, outcome, details)
end

local function onPromptTriggered(session: Session, guest: Guest, player: Player, deadline: number)
	if player ~= session.player or guest.state ~= "Waiting" then
		return
	end
	if not promptLimiter:allow(player) then
		return
	end
	-- Résultats des outils : envoyés seulement si le joueur les a achetés
	local data = PlayerDataService.GetData(player)
	local tools = if data then data.Tools else {}
	local toolResults = {
		UV = if tools.UVLamp then guest.profile.Clues.UV ~= nil else nil,
		Thermal = if tools.ThermalScanner then guest.profile.Temperature else nil,
	}
	local info: Types.ReceptionInfo = {
		Token = guest.token,
		Name = guest.profile.Name,
		PhotoAppearance = guest.profile.PhotoAppearance,
		Registry = guest.profile.Registry,
		Deadline = deadline,
		Guest = guest.model,
		ToolResults = toolResults,
	}
	Remotes.getEvent("ReceptionShow"):FireClient(player, info)
end

-- Un client complet : arrivée, attente de la décision, résultat
local function serveOneGuest(session: Session)
	local options: GuestGenerator.Options = session.forceNext or {}
	session.forceNext = nil
	-- « Nuit chanceuse » (produit Robux) : anomalies rares plus fréquentes
	local data = PlayerDataService.GetData(session.player)
	if data and data.LuckyUntil > os.time() then
		options.RarityLuck = MonetizationConfig.Products.LuckyNight.RarityLuck
	end
	local profile = GuestGenerator.generate(rng, options)

	nextToken += 1
	local model = buildGuestModel(session, profile)
	local guest: Guest = {
		token = nextToken,
		profile = profile,
		model = model,
		state = "Arriving",
		decision = nil,
	}
	session.guest = guest

	local spot = getMarker(session.hotel, "GuestSpot")
	walkTo(model, spot.Position, 8)
	if not session.active or not model.Parent then
		return
	end
	-- Bien placé face au comptoir, et immobile
	RigAppearance.placeOnFloor(model, spot.CFrame)
	setAnchored(model, true)

	local deadline = workspace:GetServerTimeNow() + GuestConfig.Patience
	local root = getRoot(model)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Recevoir"
	prompt.ObjectText = profile.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OnlyUserId", session.player.UserId)
	prompt.Parent = root or model
	prompt.Triggered:Connect(function(player)
		onPromptTriggered(session, guest, player, deadline)
	end)

	guest.state = "Waiting"
	while guest.state == "Waiting" and session.active and workspace:GetServerTimeNow() < deadline do
		task.wait(0.2)
	end
	if not session.active then
		return
	end
	guest.state = "Decided"
	session.guest = nil
	resolve(session, guest, guest.decision or "Timeout")
end

local function runSession(session: Session)
	while session.active do
		-- TimeScale : accélération du temps (commande debug !temps)
		local timeScale = (session.player:GetAttribute("TimeScale") :: number?) or 1
		task.wait(rng:NextNumber(GuestConfig.SpawnDelayMin, GuestConfig.SpawnDelayMax) / timeScale)
		if not session.active or session.player.Parent ~= Players then
			break
		end
		local ok, err = pcall(serveOneGuest, session)
		if not ok then
			warn(`[GuestService] Erreur client : {err}`)
			local guest = session.guest
			if guest then
				guest.model:Destroy()
				session.guest = nil
			end
			task.wait(2)
		end
	end
end

local function onDecision(player: Player, token: any, choice: any)
	-- Vérifications : types, fréquence, client attendu, distance
	if typeof(token) ~= "number" or (choice ~= "Accept" and choice ~= "Capture") then
		return
	end
	if not decisionLimiter:allow(player) then
		return
	end
	local session = sessions[player]
	local guest = session and session.guest
	if not session or not guest or guest.token ~= token or guest.state ~= "Waiting" then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local spot = getMarker(session.hotel, "GuestSpot")
	if not root or not root:IsA("BasePart") or (root.Position - spot.Position).Magnitude > MAX_DECISION_DISTANCE then
		Notify.send(player, "Rapproche-toi du comptoir !", "Bad")
		return
	end
	guest.decision = choice
	guest.state = "Decided"
end

local function onHotelAssigned(player: Player, hotel: Model)
	local session: Session = {
		player = player,
		hotel = hotel,
		active = true,
		guest = nil,
		extraModels = {},
		forceNext = nil,
	}
	-- Nouveau joueur : le 1er client est une anomalie commune, facile à repérer
	local data = PlayerDataService.GetData(player)
	if data and not data.TutorialDone then
		session.forceNext = { ForceAnomalyId = "Doppelganger" }
	end
	sessions[player] = session
	task.spawn(runSession, session)
end

local function onHotelReleased(player: Player, _hotel: Model)
	local session = sessions[player]
	if not session then
		return
	end
	session.active = false
	sessions[player] = nil
	if session.guest then
		session.guest.model:Destroy()
		session.guest = nil
	end
	for model in session.extraModels do
		model:Destroy()
	end
	table.clear(session.extraModels)
end

-- Debug : impose le prochain client (anomalie, vrai client, ou anomalie précise)
function GuestService.ForceNext(player: Player, options: GuestGenerator.Options)
	local session = sessions[player]
	if session then
		session.forceNext = options
	end
end

function GuestService.Init(_self: typeof(GuestService))
	local folder = Instance.new("Folder")
	folder.Name = "Guests"
	folder.Parent = workspace
	guestsFolder = folder

	HotelService.HotelAssigned:Connect(onHotelAssigned)
	HotelService.HotelReleased:Connect(onHotelReleased)
	Remotes.getEvent("ReceptionDecision").OnServerEvent:Connect(onDecision)
end

return GuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">HotelService</string>
            <string name="Source"><![CDATA[--!strict
-- Construit la carte et attribue un hôtel libre à chaque joueur qui arrive.
-- L'hôtel est libéré quand le joueur quitte.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local MapBuilder = require(Server:WaitForChild("Modules"):WaitForChild("MapBuilder"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local HotelService = {}

-- (player, hotel) : un hôtel vient d'être attribué
HotelService.HotelAssigned = Signal.new()
-- (player, hotel) : le joueur part, l'hôtel va être libéré
HotelService.HotelReleased = Signal.new()

local hotels: { Model } = {}
local ownerOf: { [Model]: Player } = {}
local hotelOf: { [Player]: Model } = {}
local characterConnections: { [Player]: RBXScriptConnection } = {}

local function setSignText(hotel: Model, text: string)
	local sign = hotel:FindFirstChild("Sign")
	local label = sign and sign:FindFirstChild("OwnerLabel", true)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

-- Téléporte le personnage du joueur devant son comptoir
local function teleportHome(player: Player, character: Model)
	local hotel = hotelOf[player]
	local spawnPart = hotel and hotel:FindFirstChild("OwnerSpawn")
	if not spawnPart or not spawnPart:IsA("BasePart") then
		return
	end
	-- On attend que le personnage soit complètement chargé
	local root = character:WaitForChild("HumanoidRootPart", 5)
	-- Petit délai : Roblox place d'abord le personnage sur le SpawnLocation
	task.wait(0.2)
	if root and character.Parent and hotelOf[player] == hotel then
		character:PivotTo(spawnPart.CFrame + Vector3.new(0, 3, 0))
	end
end

local function assignHotel(player: Player)
	if hotelOf[player] or player.Parent ~= Players then
		return
	end
	local hotel: Model? = nil
	for _, candidate in hotels do
		if not ownerOf[candidate] then
			hotel = candidate
			break
		end
	end
	if not hotel then
		-- Ne devrait pas arriver si « Max Players » = nombre d'hôtels
		warn(`[HotelService] Aucun hôtel libre pour {player.Name}`)
		player:Kick("Ce serveur est plein (tous les hôtels sont pris). Rejoins un autre serveur !")
		return
	end

	ownerOf[hotel] = player
	hotelOf[player] = hotel
	hotel:SetAttribute("OwnerUserId", player.UserId)
	player:SetAttribute("HotelIndex", hotel:GetAttribute("HotelIndex"))
	setSignText(hotel, `Hôtel de {player.DisplayName}`)

	characterConnections[player] = player.CharacterAdded:Connect(function(character)
		teleportHome(player, character)
	end)
	if player.Character then
		task.spawn(teleportHome, player, player.Character)
	end

	HotelService.HotelAssigned:Fire(player, hotel)
end

local function releaseHotel(player: Player)
	local hotel = hotelOf[player]
	if not hotel then
		return
	end
	HotelService.HotelReleased:Fire(player, hotel)

	hotelOf[player] = nil
	ownerOf[hotel] = nil
	hotel:SetAttribute("OwnerUserId", nil)
	setSignText(hotel, "Hôtel libre")

	local connection = characterConnections[player]
	if connection then
		connection:Disconnect()
		characterConnections[player] = nil
	end
end

function HotelService.GetHotel(player: Player): Model?
	return hotelOf[player]
end

function HotelService.GetOwner(hotel: Model): Player?
	return ownerOf[hotel]
end

function HotelService.Init(_self: typeof(HotelService))
	local map = MapBuilder.build()
	local hotelsFolder = map:WaitForChild("Hotels")
	for _, child in hotelsFolder:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("HotelIndex") then
			table.insert(hotels, child)
		end
	end
	table.sort(hotels, function(a, b)
		return (a:GetAttribute("HotelIndex") :: number) < (b:GetAttribute("HotelIndex") :: number)
	end)

	PlayerDataService.DataLoaded:Connect(assignHotel)
	Players.PlayerRemoving:Connect(releaseHotel)
end

return HotelService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">IncomeService</string>
            <string name="Source"><![CDATA[--!strict
-- Revenu passif : chaque seconde, les anomalies en cellule rapportent de l'argent.
-- Le revenu par seconde est publié dans l'attribut « Income » du joueur (pour l'UI).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local EconomyConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("EconomyConfig"))
local IncomeCalculator = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Modules"):WaitForChild("IncomeCalculator"))
local AnomalyService = require(script.Parent:WaitForChild("AnomalyService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local IncomeService = {}

type Debuff = { multiplier: number, endsAt: number }
local debuffs: { [Player]: Debuff } = {}

-- Multiplicateur temporaire (ex. anomalie échappée : x0.5 pendant 30 s)
function IncomeService.ApplyDebuff(player: Player, multiplier: number, duration: number)
	local endsAt = workspace:GetServerTimeNow() + duration
	debuffs[player] = { multiplier = multiplier, endsAt = endsAt }
	player:SetAttribute("DebuffEndsAt", endsAt)
	player:SetAttribute("DebuffMultiplier", multiplier)
end

local function getDebuffMultiplier(player: Player): number
	local debuff = debuffs[player]
	if not debuff then
		return 1
	end
	if workspace:GetServerTimeNow() >= debuff.endsAt then
		debuffs[player] = nil
		player:SetAttribute("DebuffEndsAt", nil)
		player:SetAttribute("DebuffMultiplier", nil)
		return 1
	end
	return debuff.multiplier
end

-- Revenu par seconde actuel du joueur (tous multiplicateurs compris)
function IncomeService.GetIncome(player: Player): number
	local data = PlayerDataService.GetData(player)
	if not data then
		return 0
	end
	-- Gamepass « Argent x2 » : attribut posé par MonetizationService
	local passMultiplier = if player:GetAttribute("Pass_DoubleMoney") then 2 else 1
	local multiplier = data.RebirthMultiplier * getDebuffMultiplier(player) * passMultiplier
	return IncomeCalculator.total(data.Anomalies, multiplier)
end

local function refreshIncome(player: Player)
	player:SetAttribute("Income", IncomeService.GetIncome(player))
end

function IncomeService.Init(_self: typeof(IncomeService))
	AnomalyService.AnomaliesChanged:Connect(refreshIncome)
	Players.PlayerRemoving:Connect(function(player)
		debuffs[player] = nil
	end)
end

function IncomeService.Start(_self: typeof(IncomeService))
	local tick = EconomyConfig.IncomeTickSeconds
	while true do
		task.wait(tick)
		for _, player in Players:GetPlayers() do
			if PlayerDataService.IsLoaded(player) then
				local income = IncomeService.GetIncome(player)
				player:SetAttribute("Income", income)
				if income > 0 then
					-- TimeScale : accélération du temps (commande debug !temps)
					local timeScale = (player:GetAttribute("TimeScale") :: number?) or 1
					PlayerDataService.AddMoney(player, income * tick * timeScale)
				end
			end
		end
	end
end

return IncomeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- Classements :
--  - dans le serveur : liste des joueurs (en haut à droite) avec revenu/s et anomalies
--  - mondial : panneau sur la place, meilleurs revenus/s de tous les temps
--    (OrderedDataStore ; indisponible dans un fichier Studio non publié)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("Format"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local STAT_INCOME = "Revenu/s"
local STAT_ANOMALIES = "Anomalies"
local LOCAL_REFRESH = 2 -- secondes
local GLOBAL_WRITE = 120 -- secondes entre deux envois d'un joueur au classement mondial
local GLOBAL_READ = 60 -- secondes entre deux mises à jour du panneau
local GLOBAL_SIZE = 10

local LeaderboardService = {}

local lastWritten: { [Player]: number } = {}
local nameCache: { [number]: string } = {}

local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats" -- nom imposé par Roblox
	local income = Instance.new("IntValue")
	income.Name = STAT_INCOME
	income.Parent = folder
	local anomalies = Instance.new("IntValue")
	anomalies.Name = STAT_ANOMALIES
	anomalies.Parent = folder
	folder.Parent = player
end

local function updateLeaderstats(player: Player)
	local folder = player:FindFirstChild("leaderstats")
	local data = PlayerDataService.GetData(player)
	if not folder or not data then
		return
	end
	local count = 0
	for _ in data.Anomalies do
		count += 1
	end
	local income = folder:FindFirstChild(STAT_INCOME)
	local anomalies = folder:FindFirstChild(STAT_ANOMALIES)
	if income and income:IsA("IntValue") then
		income.Value = math.floor((player:GetAttribute("Income") :: number?) or 0)
	end
	if anomalies and anomalies:IsA("IntValue") then
		anomalies.Value = count
	end
end

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok then name else "?"
	nameCache[userId] = result
	return result
end

local function getBoardLabel(): TextLabel?
	local map = workspace:FindFirstChild("Map")
	local board = map and map:FindFirstChild("Leaderboard")
	local label = board and board:FindFirstChild("Lines", true)
	return if label and label:IsA("TextLabel") then label else nil
end

function LeaderboardService.Init(_self: typeof(LeaderboardService))
	PlayerDataService.DataLoaded:Connect(setupLeaderstats)
	Players.PlayerRemoving:Connect(function(player)
		lastWritten[player] = nil
	end)
end

function LeaderboardService.Start(_self: typeof(LeaderboardService))
	-- Classement du serveur
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				updateLeaderstats(player)
			end
			task.wait(LOCAL_REFRESH)
		end
	end)

	-- Classement mondial
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore("BestIncome_v1")
	end)
	local label = getBoardLabel()
	if not ok then
		if label then
			label.Text = "Classement mondial disponible une fois le jeu publié"
		end
		return
	end

	local lastRead = 0
	while true do
		-- Envoi des revenus des joueurs (on garde leur meilleur score)
		for _, player in Players:GetPlayers() do
			local income = math.floor((player:GetAttribute("Income") :: number?) or 0)
			local last = lastWritten[player] or 0
			if income > 0 and os.clock() - last > GLOBAL_WRITE then
				lastWritten[player] = os.clock()
				pcall(function()
					store:UpdateAsync(tostring(player.UserId), function(old)
						return math.max(old or 0, income)
					end)
				end)
			end
		end

		-- Mise à jour du panneau
		if os.clock() - lastRead > GLOBAL_READ then
			lastRead = os.clock()
			local success, pages = pcall(function()
				return store:GetSortedAsync(false, GLOBAL_SIZE)
			end)
			label = getBoardLabel()
			if label then
				if success then
					local lines = {}
					for rank, entry in pages:GetCurrentPage() do
						local userId = tonumber(entry.key)
						local name = if userId then getName(userId) else "?"
						table.insert(lines, `{rank}. {name} — {Format.money(entry.value)}/s`)
					end
					label.Text = if #lines > 0 then table.concat(lines, "\n") else "Personne pour l'instant !"
				else
					label.Text = "Classement mondial disponible une fois le jeu publié"
				end
			end
		end
		task.wait(10)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">LockService</string>
            <string name="Source"><![CDATA[--!strict
-- Verrou de base : le propriétaire ferme sa porte pendant un temps (60 s + bonus),
-- puis doit attendre avant de pouvoir reverrouiller.
-- La barrière bloque tout le monde sauf le propriétaire et les clients (groupes de collision).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")

local Remotes = require(Shared:WaitForChild("Remotes"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local CollisionGroups = require(Server:WaitForChild("Modules"):WaitForChild("CollisionGroups"))
local Notify = require(Server:WaitForChild("Modules"):WaitForChild("Notify"))
local RateLimiter = require(Server:WaitForChild("Util"):WaitForChild("RateLimiter"))
local HotelService = require(script.Parent:WaitForChild("HotelService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local LockService = {}

local lockLimiter = RateLimiter.new(2, 1)
local characterConnections: { [Player]: { RBXScriptConnection } } = {}

local function getBarrier(hotel: Model): BasePart?
	local barrier = hotel:FindFirstChild("DoorBarrier")
	return if barrier and barrier:IsA("BasePart") then barrier else nil
end

local function setBarrierLocked(hotel: Model, locked: boolean)
	local barrier = getBarrier(hotel)
	if barrier then
		barrier.CanCollide = locked
		barrier.Transparency = if locked then 0.35 else 1
	end
	hotel:SetAttribute("Locked", locked)
end

function LockService.IsLocked(hotel: Model): boolean
	return hotel:GetAttribute("Locked") == true
end

local function disconnectAll(player: Player)
	local connections = characterConnections[player]
	if connections then
		for _, connection in connections do
			connection:Disconnect()
		end
	end
	characterConnections[player] = nil
end

-- Le personnage du propriétaire traverse sa propre barrière
local function onHotelAssigned(player: Player, hotel: Model)
	local index = hotel:GetAttribute("HotelIndex") :: number
	local group = CollisionGroups.owner(index)
	local connections: { RBXScriptConnection } = {}
	characterConnections[player] = connections
	local function onCharacter(character: Model)
		table.insert(connections, CollisionGroups.assign(character, group))
	end
	if player.Character then
		onCharacter(player.Character)
	end
	table.insert(connections, player.CharacterAdded:Connect(onCharacter))
	player:SetAttribute("LockEndsAt", nil)
	player:SetAttribute("LockReadyAt", nil)
end

local function onHotelReleased(player: Player, hotel: Model)
	disconnectAll(player)
	setBarrierLocked(hotel, false)
	if player.Character then
		CollisionGroups.assign(player.Character, "Default"):Disconnect()
	end
end

local function onLockRequest(player: Player)
	if not lockLimiter:allow(player) then
		return
	end
	local hotel = HotelService.GetHotel(player)
	local data = PlayerDataService.GetData(player)
	if not hotel or not data then
		return
	end
	local now = workspace:GetServerTimeNow()
	local readyAt = (player:GetAttribute("LockReadyAt") :: number?) or 0
	if now < readyAt then
		return
	end

	local duration = ShopConfig.lockDuration(data.SecurityUpgrades.LockPlus or 0)
	local endsAt = now + duration
	player:SetAttribute("LockEndsAt", endsAt)
	player:SetAttribute("LockReadyAt", endsAt + ShopConfig.Lock.Cooldown)
	setBarrierLocked(hotel, true)
	Notify.send(player, `Porte verrouillée pendant {duration} s`, "Good")

	task.delay(duration, function()
		-- Toujours le même propriétaire et le même verrouillage ?
		if HotelService.GetHotel(player) == hotel and player:GetAttribute("LockEndsAt") == endsAt then
			setBarrierLocked(hotel, false)
			Notify.send(player, "Ta porte est déverrouillée !", "Bad")
		end
	end)
end

function LockService.Init(_self: typeof(LockService))
	HotelService.HotelAssigned:Connect(onHotelAssigned)
	HotelService.HotelReleased:Connect(onHotelReleased)
	Players.PlayerRemoving:Connect(disconnectAll)
	Remotes.getEvent("LockRequest").OnServerEvent:Connect(onLockRequest)
end

function LockService.Start(_self: typeof(LockService))
	CollisionGroups.setup(GameConfig.HotelCount)
	local hotels = workspace:WaitForChild("Map"):WaitForChild("Hotels")
	for _, hotel in hotels:GetChildren() do
		local index = hotel:GetAttribute("HotelIndex")
		local barrier = hotel:IsA("Model") and getBarrier(hotel)
		if typeof(index) == "number" and barrier then
			barrier.CollisionGroup = CollisionGroups.barrier(index)
		end
	end
end

return LockService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- Achats Robux : gamepasses (permanents) et produits (répétables).
-- Les gamepasses possédés sont publiés en attributs Pass_<nom> (lus par les autres services).
-- ProcessReceipt est idempotent : chaque achat est enregistré dans les données
-- et on ne confirme à Roblox (PurchaseGranted) qu'une fois la sauvegarde faite.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("Format"))
local Notify = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Modules"):WaitForChild("Notify"))
local Analytics = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Modules"):WaitForChild("Analytics"))
local AnomalyService = require(script.Parent:WaitForChild("AnomalyService"))
local IncomeService = require(script.Parent:WaitForChild("IncomeService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local MAX_RECEIPTS_KEPT = 100 -- achats mémorisés par joueur (anti-doublon)
local SAVE_TIMEOUT = 15

local MonetizationService = {}

-- Applique les effets d'un gamepass possédé
local function grantPass(player: Player, passName: string)
	if player:GetAttribute(`Pass_{passName}`) then
		return
	end
	player:SetAttribute(`Pass_{passName}`, true)
	if passName == "ExtraCells" then
		AnomalyService.RefreshCells(player)
	end
	AnomalyService.AnomaliesChanged:Fire(player) -- recalcule le revenu
end

local function passNameFromId(passId: number): string?
	for name, pass in MonetizationConfig.GamePasses do
		if pass.Id ~= 0 and pass.Id == passId then
			return name
		end
	end
	return nil
end

-- À la connexion : vérifie les gamepasses (avec le cache si Roblox ne répond pas)
local function checkPasses(player: Player, data: any)
	for name, pass in MonetizationConfig.GamePasses do
		if pass.Id ~= 0 then
			local key = tostring(pass.Id)
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok then
				data.GamepassCache[key] = owns or nil
			end
			if data.GamepassCache[key] and player.Parent == Players then
				grantPass(player, name)
			end
		end
	end
end

-- Effet d'un produit acheté. Renvoie false si l'Id est inconnu.
local function applyProduct(player: Player, data: any, productId: number): boolean
	local products = MonetizationConfig.Products
	if products.MoneyPack.Id ~= 0 and productId == products.MoneyPack.Id then
		local pack = products.MoneyPack
		local amount = math.max(pack.Minimum, math.floor(IncomeService.GetIncome(player) * pack.IncomeSeconds))
		PlayerDataService.AddMoney(player, amount)
		Notify.send(player, `Merci ! +{Format.money(amount)}`, "Good")
		return true
	elseif products.LuckyNight.Id ~= 0 and productId == products.LuckyNight.Id then
		local night = products.LuckyNight
		-- Si une nuit est déjà en cours, on prolonge
		data.LuckyUntil = math.max(data.LuckyUntil, os.time()) + night.Duration
		player:SetAttribute("LuckyUntil", data.LuckyUntil)
		Notify.send(player, "Nuit chanceuse ! Anomalies rares x3 pendant 10 min", "Good")
		return true
	end
	return false
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and PlayerDataService.GetData(player)
	if not player or not data then
		-- Le joueur n'est pas (encore) là : Roblox réessaiera plus tard
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local purchaseId = tostring(receipt.PurchaseId)
	if not data.ProcessedReceipts[purchaseId] then
		if not applyProduct(player, data, receipt.ProductId) then
			warn(`[Monetization] Produit inconnu : {receipt.ProductId}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		data.ProcessedReceipts[purchaseId] = true
		Analytics.event(player, "RobuxProduct", receipt.CurrencySpent)
		table.insert(data.ReceiptOrder, purchaseId)
		while #data.ReceiptOrder > MAX_RECEIPTS_KEPT do
			local oldest = table.remove(data.ReceiptOrder, 1)
			data.ProcessedReceipts[oldest] = nil
		end
	end

	-- On attend que l'achat soit réellement sauvegardé avant de confirmer
	local saved = PlayerDataService.SaveAndWait(player, function(lastSaved)
		return lastSaved.ProcessedReceipts ~= nil and lastSaved.ProcessedReceipts[purchaseId] == true
	end, SAVE_TIMEOUT)
	if saved then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- Au démarrage : vérifie que chaque ID correspond au bon achat (par son nom sur Roblox)
-- et l'écrit dans Output. Aide à repérer deux IDs inversés.
local EXPECTED_WORDS: { [string]: string } = {
	DoubleMoney = "argent",
	ExtraCells = "cellule",
	MoneyPack = "sac",
	LuckyNight = "nuit",
}

local function checkIds()
	local function check(key: string, id: number, infoType: Enum.InfoType)
		if id == 0 then
			return
		end
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, infoType)
		end)
		if not ok or not info then
			warn(`[Monetization] Impossible de lire l'achat {key} ({id})`)
			return
		end
		local name = string.lower(info.Name or "")
		if string.find(name, EXPECTED_WORDS[key], 1, true) then
			print(`[Monetization] OK : {key} = « {info.Name} » ({id})`)
		else
			warn(`[Monetization] ATTENTION : {key} ({id}) s'appelle « {info.Name} » sur Roblox`)
		end
	end
	for key, pass in MonetizationConfig.GamePasses do
		check(key, pass.Id, Enum.InfoType.GamePass)
	end
	for key, product in MonetizationConfig.Products do
		check(key, product.Id, Enum.InfoType.Product)
	end
end

function MonetizationService.Start(_self: typeof(MonetizationService))
	checkIds()
end

function MonetizationService.Init(_self: typeof(MonetizationService))
	PlayerDataService.DataLoaded:Connect(function(player, data)
		player:SetAttribute("LuckyUntil", data.LuckyUntil)
		checkPasses(player, data)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passNameFromId(passId)
		local data = PlayerDataService.GetData(player)
		if purchased and name and data then
			data.GamepassCache[tostring(passId)] = true
			Analytics.event(player, `RobuxPass{name}`)
			grantPass(player, name)
			Notify.send(player, `Merci ! Gamepass « {MonetizationConfig.GamePasses[name].DisplayName} » activé`, "Good")
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
-- Charge et sauvegarde les données des joueurs avec ProfileStore
-- (verrouillage de session : pas de perte ni de duplication entre serveurs).
-- Dans Studio sans accès aux API, ProfileStore utilise une sauvegarde factice
-- (les données ne sont pas conservées entre deux tests).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ProfileStore = require(Server:WaitForChild("Vendor"):WaitForChild("ProfileStore"))
local DataSchema = require(Server:WaitForChild("Modules"):WaitForChild("DataSchema"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local Analytics = require(Server:WaitForChild("Modules"):WaitForChild("Analytics"))

local PlayerDataService = {}

-- Déclenché quand les données d'un joueur sont prêtes : (player, data)
PlayerDataService.DataLoaded = Signal.new()

local store = ProfileStore.New(GameConfig.DataStoreName, DataSchema.TEMPLATE)
local profiles: { [Player]: any } = {}
local joinTimes: { [Player]: number } = {}

local function profileKey(player: Player): string
	return `Player_{player.UserId}`
end

local function onPlayerAdded(player: Player)
	local profile = store:StartSessionAsync(profileKey(player), {
		-- Arrête d'essayer si le joueur part pendant le chargement
		Cancel = function()
			return player.Parent ~= Players
		end,
	})

	if profile == nil then
		-- Un autre serveur garde la session ou Roblox est en panne
		if player.Parent == Players then
			player:Kick("Impossible de charger tes données. Réessaie dans un instant.")
		end
		return
	end

	profile:AddUserId(player.UserId) -- conformité RGPD
	profile:Reconcile() -- ajoute les champs manquants depuis le modèle
	DataSchema.migrate(profile.Data)

	profile.OnSessionEnd:Connect(function()
		profiles[player] = nil
		if player.Parent == Players then
			player:Kick("Ta session a été ouverte ailleurs. Reconnecte-toi.")
		end
	end)

	if player.Parent ~= Players then
		-- Parti pendant le chargement
		profile:EndSession()
		return
	end

	profiles[player] = profile
	joinTimes[player] = os.clock()
	local data = profile.Data
	data.LastLogin = os.time()

	player:SetAttribute("Money", data.Money)
	player:SetAttribute("TutorialDone", data.TutorialDone)
	PlayerDataService.DataLoaded:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local joinedAt = joinTimes[player]
	joinTimes[player] = nil
	if joinedAt then
		Analytics.event(player, "SessionLength", math.floor(os.clock() - joinedAt))
	end
	local profile = profiles[player]
	if profile then
		profiles[player] = nil
		profile:EndSession()
	end
end

-- Données du joueur, ou nil si pas (encore) chargées.
-- Les modifications sont sauvegardées automatiquement.
function PlayerDataService.GetData(player: Player): any?
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function PlayerDataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function PlayerDataService.GetMoney(player: Player): number
	local data = PlayerDataService.GetData(player)
	return if data then data.Money else 0
end

local function setMoney(player: Player, data: any, amount: number)
	data.Money = math.max(0, amount)
	player:SetAttribute("Money", data.Money)
end

-- Ajoute (ou retire si négatif) de l'argent. Ne descend jamais sous 0.
function PlayerDataService.AddMoney(player: Player, amount: number)
	local data = PlayerDataService.GetData(player)
	if not data or amount ~= amount then -- amount ~= amount : NaN
		return
	end
	setMoney(player, data, data.Money + amount)
end

-- Dépense si le joueur a assez. Renvoie true si l'achat est passé.
function PlayerDataService.TrySpend(player: Player, amount: number): boolean
	local data = PlayerDataService.GetData(player)
	if not data or amount < 0 or data.Money < amount then
		return false
	end
	setMoney(player, data, data.Money - amount)
	return true
end

-- Sauvegarde tout de suite et attend que check(dernières données sauvegardées)
-- soit vrai. Sert aux achats Robux : on ne confirme qu'une fois l'achat sauvegardé.
function PlayerDataService.SaveAndWait(player: Player, check: (any) -> boolean, timeout: number): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if profile.LastSavedData and check(profile.LastSavedData) then
		return true
	end
	local saved = false
	local connection = profile.OnAfterSave:Connect(function(lastSavedData)
		if check(lastSavedData) then
			saved = true
		end
	end)
	profile:Save()
	local elapsed = 0
	while not saved and elapsed < timeout and profile:IsActive() do
		elapsed += task.wait(0.2)
	end
	connection:Disconnect()
	return saved
end

-- Remet les données à zéro (commande debug) puis expulse le joueur
function PlayerDataService.ResetData(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	for key in profile.Data do
		profile.Data[key] = nil
	end
	for key, value in DataSchema.TEMPLATE do
		profile.Data[key] = if type(value) == "table" then table.clone(value) else value
	end
	player:Kick("Données réinitialisées. Relance le jeu.")
end

function PlayerDataService.Init(_self: typeof(PlayerDataService))
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

function PlayerDataService.Start(_self: typeof(PlayerDataService))
	Players.PlayerAdded:Connect(onPlayerAdded)
	-- Joueurs déjà présents (fréquent dans Studio)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- Boutique : cellules supplémentaires, outils de détection, améliorations de sécurité.
-- Le client envoie seulement « je veux acheter X » ; le serveur vérifie le prix et l'argent.
-- Ce que possède le joueur est publié en attributs (lus par l'interface) :
--   CellsUnlocked, Tool_<id> = true, Sec_<id> = niveau

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")

local Remotes = require(Shared:WaitForChild("Remotes"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Notify = require(Server:WaitForChild("Modules"):WaitForChild("Notify"))
local Analytics = require(Server:WaitForChild("Modules"):WaitForChild("Analytics"))
local RateLimiter = require(Server:WaitForChild("Util"):WaitForChild("RateLimiter"))
local AnomalyService = require(script.Parent:WaitForChild("AnomalyService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local ShopService = {}

local buyLimiter = RateLimiter.new(4, 1)

local function publishOwnership(player: Player, data: any)
	player:SetAttribute("CellsUnlocked", data.CellsUnlocked)
	for toolId in ShopConfig.Tools do
		player:SetAttribute(`Tool_{toolId}`, data.Tools[toolId] == true)
	end
	for upgradeId in ShopConfig.Security do
		player:SetAttribute(`Sec_{upgradeId}`, data.SecurityUpgrades[upgradeId] or 0)
	end
end

local function pay(player: Player, price: number, itemName: string): boolean
	if PlayerDataService.TrySpend(player, price) then
		local data = PlayerDataService.GetData(player)
		if data then
			Analytics.first(player, data, "ShopPurchase")
		end
		Notify.send(player, `Acheté : {itemName} (-{Format.money(price)})`, "Good")
		return true
	end
	Notify.send(player, `Pas assez d'argent pour {itemName}`, "Bad")
	return false
end

local function onBuy(player: Player, category: any, itemId: any)
	if typeof(category) ~= "string" or typeof(itemId) ~= "string" or not buyLimiter:allow(player) then
		return
	end
	local data = PlayerDataService.GetData(player)
	if not data then
		return
	end

	if category == "Cell" then
		local purchased = data.CellsUnlocked - GameConfig.BaseCells
		local price = ShopConfig.nextCellPrice(purchased)
		if price and pay(player, price, "Cellule") then
			data.CellsUnlocked += 1
			AnomalyService.RefreshCells(player)
		end
	elseif category == "Tool" then
		local tool = (ShopConfig.Tools :: any)[itemId]
		if tool and not data.Tools[itemId] and pay(player, tool.Price, tool.DisplayName) then
			data.Tools[itemId] = true
		end
	elseif category == "Security" then
		local upgrade = (ShopConfig.Security :: any)[itemId]
		local level = data.SecurityUpgrades[itemId] or 0
		local price = ShopConfig.nextSecurityPrice(itemId, level)
		if upgrade and price and pay(player, price, `{upgrade.DisplayName} niv. {level + 1}`) then
			data.SecurityUpgrades[itemId] = level + 1
		end
	end
	publishOwnership(player, data)
end

function ShopService.Init(_self: typeof(ShopService))
	PlayerDataService.DataLoaded:Connect(publishOwnership)
	Remotes.getEvent("ShopBuy").OnServerEvent:Connect(onBuy)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[--!strict
-- Vol entre joueurs : un voleur prend une anomalie dans la cellule d'un autre,
-- la porte au-dessus de sa tête (vitesse réduite) et doit rejoindre son hôtel.
-- Le propriétaire peut la récupérer en touchant le voleur (invite « Récupérer »).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")

local AnomalyConfig = require(Config:WaitForChild("AnomalyConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local Notify = require(Server:WaitForChild("Modules"):WaitForChild("Notify"))
local Analytics = require(Server:WaitForChild("Modules"):WaitForChild("Analytics"))
local AnomalyService = require(script.Parent:WaitForChild("AnomalyService"))
local HotelService = require(script.Parent:WaitForChild("HotelService"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local NORMAL_WALK_SPEED = 16
local MAX_START_DISTANCE = 16

type Steal = {
	thief: Player,
	owner: Player,
	uid: string,
	anomalyId: string,
	carried: Model,
	startedAt: number,
	diedConnection: RBXScriptConnection?,
}

local StealService = {}

local stealsByThief: { [Player]: Steal } = {}

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function setWalkSpeed(player: Player, speed: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = speed
	end
end

local function isUidBeingStolen(owner: Player, uid: string): boolean
	for _, steal in stealsByThief do
		if steal.owner == owner and steal.uid == uid then
			return true
		end
	end
	return false
end

-- Le voleur est-il dans son propre hôtel ?
local function isInsideOwnHotel(thief: Player, root: BasePart): boolean
	local hotel = HotelService.GetHotel(thief)
	local floor = hotel and hotel:FindFirstChild("Floor")
	if not floor or not floor:IsA("BasePart") then
		return false
	end
	local localPos = floor.CFrame:PointToObjectSpace(root.Position)
	return math.abs(localPos.X) < floor.Size.X / 2 and math.abs(localPos.Z) < floor.Size.Z / 2 and localPos.Y < 25
end

-- Termine un vol. success = l'anomalie change de propriétaire.
local function finish(steal: Steal, success: boolean, reason: string?)
	if stealsByThief[steal.thief] ~= steal then
		return
	end
	stealsByThief[steal.thief] = nil
	steal.carried:Destroy()
	if steal.diedConnection then
		steal.diedConnection:Disconnect()
	end
	if steal.thief.Parent == Players then
		setWalkSpeed(steal.thief, NORMAL_WALK_SPEED)
	end

	local def = AnomalyConfig.ById[steal.anomalyId]
	local name = if def then def.DisplayName else "l'anomalie"

	if success then
		local owned = AnomalyService.RemoveAnomaly(steal.owner, steal.uid)
		if owned and AnomalyService.AddAnomaly(steal.thief, owned.Id, owned.Mutation) then
			local thiefData = PlayerDataService.GetData(steal.thief)
			local ownerData = PlayerDataService.GetData(steal.owner)
			if thiefData then
				thiefData.Stats.StealsSucceeded += 1
				Analytics.first(steal.thief, thiefData, "Steal")
			end
			if ownerData then
				ownerData.Stats.StealsSuffered += 1
			end
			Notify.send(steal.thief, `Vol réussi : {name} est à toi !`, "Good")
			Notify.send(steal.owner, `{steal.thief.DisplayName} t'a volé {name} !`, "Bad")
			return
		elseif owned then
			-- Impossible de l'ajouter au voleur (cellules pleines) : on la rend
			local ownerData = PlayerDataService.GetData(steal.owner)
			if ownerData then
				ownerData.Anomalies[steal.uid] = owned
				AnomalyService.ShowModel(steal.owner, steal.uid)
				AnomalyService.AnomaliesChanged:Fire(steal.owner)
			end
			Notify.send(steal.thief, "Tes cellules sont pleines, l'anomalie s'échappe !", "Bad")
			return
		end
	end

	-- Échec : l'anomalie retourne dans sa cellule
	if steal.owner.Parent == Players then
		AnomalyService.ShowModel(steal.owner, steal.uid)
		if reason then
			Notify.send(steal.owner, reason, "Good")
		end
	end
	if steal.thief.Parent == Players then
		Notify.send(steal.thief, `Vol raté : {name} est retournée dans sa cellule`, "Bad")
	end
end

-- Copie de l'anomalie portée au-dessus de la tête du voleur
local function buildCarried(steal: Steal, root: BasePart): Model
	local owned = AnomalyService.GetOwned(steal.owner, steal.uid)
	assert(owned, "anomalie introuvable")
	local rig = AnomalyService.BuildRig(owned.Id, owned.Mutation)
	rig.Name = "CarriedAnomaly"
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:Destroy() -- simple objet porté, pas un personnage
	end
	rig:ScaleTo(0.6)
	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.Massless = true
			descendant.CanCollide = false
			descendant.CanQuery = true
		end
	end
	local rigRoot = rig:FindFirstChild("HumanoidRootPart") :: BasePart
	rig:PivotTo(root.CFrame * CFrame.new(0, 5, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = rigRoot
	weld.Parent = rigRoot

	-- Seul le propriétaire voit l'invite « Récupérer »
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Récupérer"
	prompt.ObjectText = steal.thief.DisplayName
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OnlyUserId", steal.owner.UserId)
	prompt.Triggered:Connect(function(player)
		if player == steal.owner then
			finish(steal, false, "Tu as récupéré ton anomalie !")
		end
	end)
	prompt.Parent = rigRoot

	rig.Parent = root.Parent
	return rig
end

local function tryStart(thief: Player, owner: Player, uid: string)
	if thief == owner or stealsByThief[thief] or thief.Parent ~= Players or owner.Parent ~= Players then
		return
	end
	local owned = AnomalyService.GetOwned(owner, uid)
	local model = AnomalyService.GetModel(owner, uid)
	local root = getRoot(thief)
	if not owned or not model or not root or isUidBeingStolen(owner, uid) then
		return
	end
	if not HotelService.GetHotel(thief) then
		return
	end
	if (model:GetPivot().Position - root.Position).Magnitude > MAX_START_DISTANCE then
		return
	end
	if not AnomalyService.HasFreeCell(thief) then
		Notify.send(thief, "Tes cellules sont pleines : achète-en une à la boutique !", "Bad")
		return
	end

	local steal: Steal = {
		thief = thief,
		owner = owner,
		uid = uid,
		anomalyId = owned.Id,
		carried = (nil :: any) :: Model,
		startedAt = os.clock(),
		diedConnection = nil,
	}
	steal.carried = buildCarried(steal, root)
	stealsByThief[thief] = steal
	AnomalyService.HideModel(owner, uid)

	local ownerData = PlayerDataService.GetData(owner)
	local trapLevel = if ownerData then ownerData.SecurityUpgrades.SlowTrap or 0 else 0
	setWalkSpeed(thief, ShopConfig.carrySpeed(trapLevel))

	local humanoid = thief.Character and thief.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		steal.diedConnection = humanoid.Died:Connect(function()
			finish(steal, false, nil)
		end)
	end

	local def = AnomalyConfig.ById[owned.Id]
	Notify.send(owner, `ALERTE : {thief.DisplayName} vole {def.DisplayName} ! Rattrape-le !`, "Bad")
	Notify.send(thief, "Ramène-la dans ton hôtel !", "Info")
end

function StealService.Init(_self: typeof(StealService))
	AnomalyService.StealRequested:Connect(tryStart)

	Players.PlayerRemoving:Connect(function(player)
		for _, steal in table.clone(stealsByThief) do
			if steal.thief == player or steal.owner == player then
				finish(steal, false, nil)
			end
		end
	end)
end

function StealService.Start(_self: typeof(StealService))
	-- Vérifie régulièrement : arrivée à l'hôtel, délai dépassé, personnage disparu
	while true do
		task.wait(0.25)
		for _, steal in table.clone(stealsByThief) do
			local root = getRoot(steal.thief)
			if not root or not steal.carried.Parent then
				finish(steal, false, nil)
			elseif isInsideOwnHotel(steal.thief, root) then
				finish(steal, true, nil)
			elseif os.clock() - steal.startedAt > ShopConfig.Steal.Timeout then
				finish(steal, false, "Le voleur a mis trop de temps, ton anomalie est revenue.")
			end
		end
	end
end

return StealService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict
-- Tutoriel des nouveaux joueurs (3 étapes, affiché par TutorialController).
-- Le serveur mémorise qu'il est terminé et envoie les étapes aux statistiques.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Analytics = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Modules"):WaitForChild("Analytics"))
local RateLimiter = require(ServerScriptService:WaitForChild("Server"):WaitForChild("Util"):WaitForChild("RateLimiter"))
local PlayerDataService = require(script.Parent:WaitForChild("PlayerDataService"))

local STEP_NAMES = { "Recevoir un client", "Prendre une décision", "Ouvrir la boutique" }

local TutorialService = {}

local limiter = RateLimiter.new(3, 1)

local function onStep(player: Player, step: any)
	if typeof(step) ~= "number" or step % 1 ~= 0 or step < 1 or step > #STEP_NAMES then
		return
	end
	local data = PlayerDataService.GetData(player)
	if not data or data.TutorialDone or not limiter:allow(player) then
		return
	end
	Analytics.funnel(player, step, STEP_NAMES[step])
	if step == #STEP_NAMES then
		data.TutorialDone = true
		player:SetAttribute("TutorialDone", true)
	end
end

function TutorialService.Init(_self: typeof(TutorialService))
	Remotes.getEvent("TutorialStep").OnServerEvent:Connect(onStep)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Limiteur de fréquence par joueur, à utiliser sur chaque RemoteEvent.
-- Exemple : local limiter = RateLimiter.new(5, 1) -- 5 appels max par seconde
--           if not limiter:allow(player) then return end

local Players = game:GetService("Players")

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type RateLimiter = typeof(setmetatable(
	{} :: {
		_maxCalls: number,
		_window: number,
		_calls: { [Player]: { count: number, windowStart: number } },
		_connection: RBXScriptConnection,
	},
	RateLimiter
))

function RateLimiter.new(maxCalls: number, windowSeconds: number): RateLimiter
	local self = setmetatable({
		_maxCalls = maxCalls,
		_window = windowSeconds,
		_calls = {},
		_connection = (nil :: any) :: RBXScriptConnection,
	}, RateLimiter)

	-- Nettoyage quand le joueur quitte
	self._connection = Players.PlayerRemoving:Connect(function(player)
		self._calls[player] = nil
	end)

	return self
end

-- Renvoie true si le joueur a le droit de faire un appel maintenant
function RateLimiter.allow(self: RateLimiter, player: Player): boolean
	local now = os.clock()
	local entry = self._calls[player]
	if not entry or now - entry.windowStart >= self._window then
		self._calls[player] = { count = 1, windowStart = now }
		return true
	end
	if entry.count >= self._maxCalls then
		return false
	end
	entry.count += 1
	return true
end

function RateLimiter.destroy(self: RateLimiter)
	self._connection:Disconnect()
	table.clear(self._calls)
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="49">
