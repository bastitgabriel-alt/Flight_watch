            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Sons du jeu. Ce sont des sons intégrés à Roblox (rbxasset://) : pour en mettre
-- d'autres, remplace par « rbxassetid://<numéro> » d'un son de la Creator Store.

local SoundConfig = {
	Good = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6 },
	Bad = { Id = "rbxasset://sounds/uuhhh.mp3", Volume = 0.5 },
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.4 },
	-- swoosh.wav n'existe plus chez Roblox
	Scare = { Id = "rbxasset://sounds/uuhhh.mp3", Volume = 1 },
}

return SoundConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Déclaration centralisée de tous les RemoteEvents et RemoteFunctions.
-- Pour ajouter un remote : ajouter son nom dans EVENT_NAMES ou FUNCTION_NAMES.
-- Le serveur les crée (Remotes.setup), le client les attend (Remotes.getEvent).
--
-- Rappel sécurité : le client n'envoie que des INTENTIONS. Le serveur vérifie
-- toujours les arguments, la distance, la propriété et la fréquence.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"

local EVENT_NAMES: { string } = {
	"Notify", -- serveur -> client : (text, kind) message à afficher
	"ReceptionShow", -- serveur -> client : (ReceptionInfo) ouvre la réception
	"ReceptionDecision", -- client -> serveur : (token, "Accept" | "Capture")
	"ReceptionResult", -- serveur -> client : (token, outcome, details)
	"ShopBuy", -- client -> serveur : ("Cell" | "Tool" | "Security", itemId)
	"LockRequest", -- client -> serveur : verrouiller sa porte
	"TutorialStep", -- client -> serveur : (numéro d'étape terminée)
}

-- Client -> serveur, avec réponse (à utiliser avec parcimonie)
local FUNCTION_NAMES: { string } = {}

local Remotes = {}

local function isDeclared(list: { string }, name: string): boolean
	return table.find(list, name) ~= nil
end

-- Serveur uniquement : crée le dossier et tous les remotes déclarés
function Remotes.setup()
	assert(RunService:IsServer(), "Remotes.setup() ne peut être appelé que par le serveur")

	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	assert(folder)

	for _, name in EVENT_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTION_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getFolder(): Instance
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Remotes.getEvent(name: string): RemoteEvent
	assert(isDeclared(EVENT_NAMES, name), `RemoteEvent non déclaré : {name}`)
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Remotes.getFunction(name: string): RemoteFunction
	assert(isDeclared(FUNCTION_NAMES, name), `RemoteFunction non déclarée : {name}`)
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Types partagés entre le serveur et le client.

export type RarityId = "Common" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Secret"

export type MutationId = "None" | "Golden" | "Neon"

-- Indices visibles par tous + indices cachés (révélés par un outil acheté)
export type ClueType = "Registry" | "Shadow" | "Eyes" | "Photo" | "UV" | "Thermal"

-- Strong = indice évident, Subtle = indice discret (anomalies rares)
export type ClueStrength = "Strong" | "Subtle"

-- Couleurs d'un personnage (placeholder avant de vrais modèles)
export type Appearance = {
	Skin: Color3,
	Shirt: Color3,
	Pants: Color3,
}

export type Rarity = {
	DisplayName: string, -- nom affiché au joueur
	Color: Color3,
	Order: number, -- 1 = la plus commune
	SpawnWeight: number, -- poids de tirage (0 = n'apparaît jamais)
	ClueCount: number, -- nombre d'indices montrés par une anomalie de cette rareté
	SubtleChance: number, -- probabilité (0 à 1) que chaque indice soit discret
	HiddenClueChance: number, -- probabilité d'un indice caché en plus (UV ou thermique)
}

export type Mutation = {
	DisplayName: string,
	IncomeMultiplier: number,
	SpawnChance: number, -- probabilité (0 à 1) d'apparition
	Color: Color3?, -- couleur appliquée au modèle dans la cellule
	Material: string?, -- nom d'un Enum.Material, ex. "Neon"
}

export type AnomalyDef = {
	Id: string,
	DisplayName: string,
	Rarity: RarityId,
	Income: number, -- argent par seconde (avant mutation et multiplicateurs)
	Description: string,
	TrueForm: Appearance, -- apparence révélée une fois dans la cellule
	EyeColor: Color3,
	Clues: { ClueType }, -- indices que cette anomalie peut montrer
}

-- Une anomalie possédée par un joueur (sauvegardée)
export type OwnedAnomaly = {
	Id: string,
	Mutation: MutationId,
	Cell: number, -- numéro de cellule, 0 = pas de cellule
}

-- Profil d'un client généré par le serveur (jamais envoyé tel quel au client)
export type GuestProfile = {
	Name: string,
	IsAnomaly: boolean,
	AnomalyId: string?,
	Mutation: MutationId,
	Appearance: Appearance, -- apparence réelle (déguisement)
	PhotoAppearance: Appearance, -- apparence sur la photo d'identité
	Registry: { string }, -- noms écrits dans le registre des réservations
	Clues: { [ClueType]: ClueStrength },
	Temperature: number, -- °C, mesurée par le scanner thermique
}

-- Ce que le client a le droit de voir quand il reçoit un client
export type ReceptionInfo = {
	Token: number,
	Name: string,
	PhotoAppearance: Appearance,
	Registry: { string },
	Deadline: number, -- workspace:GetServerTimeNow() limite
	Guest: Model?, -- le modèle 3D du client (pour cadrer la caméra)
	-- Résultats des outils possédés (absent = outil non acheté)
	ToolResults: {
		UV: boolean?, -- true = traces fluorescentes
		Thermal: number?, -- température en °C
	},
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="15">
