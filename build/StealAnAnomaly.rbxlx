          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Mise en forme des nombres pour l'affichage : 1234 -> "1.2K"

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local Format = {}

function Format.number(value: number): string
	if value ~= value then -- NaN
		return "0"
	end
	local negative = value < 0
	local n = math.abs(value)
	if n < 1000 then
		local text = tostring(math.floor(n))
		return if negative then "-" .. text else text
	end

	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	-- 1 décimale sous 100, aucune au-dessus (ex. 1.2K, 15.3K, 152K)
	local text
	if n < 100 then
		text = string.format("%.1f", math.floor(n * 10) / 10)
		text = string.gsub(text, "%.0$", "")
	else
		text = tostring(math.floor(n))
	end
	text ..= SUFFIXES[index]
	return if negative then "-" .. text else text
end

function Format.money(value: number): string
	return "$" .. Format.number(value)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Loader</string>
            <string name="Source"><![CDATA[--!strict
-- Charge les modules (services serveur ou contrôleurs client) d'un dossier.
-- Chaque module peut définir :
--   Init(self)  : appelé en premier, dans l'ordre, pour se préparer
--   Start(self) : appelé ensuite, chacun dans son propre thread
-- Un module qui plante n'empêche pas les autres de se charger.

export type Module = {
	Init: ((self: any) -> ())?,
	Start: ((self: any) -> ())?,
}

local Loader = {}

function Loader.loadModules(folder: Instance): { [string]: Module }
	local loaded: { [string]: Module } = {}

	-- 1) require de chaque ModuleScript
	for _, child in folder:GetChildren() do
		if child:IsA("ModuleScript") then
			local ok, result = pcall(require, child)
			if ok and type(result) == "table" then
				loaded[child.Name] = result :: Module
			else
				warn(`[Loader] Impossible de charger {child.Name} : {result}`)
			end
		end
	end

	-- 2) Init de chaque module (synchrone)
	for name, module in loaded do
		if module.Init then
			local ok, err = pcall(module.Init, module)
			if not ok then
				warn(`[Loader] Erreur dans {name}.Init : {err}`)
			end
		end
	end

	-- 3) Start de chaque module (chacun dans son thread)
	for name, module in loaded do
		local start = module.Start
		if start then
			task.spawn(function()
				local ok, err = pcall(start, module)
				if not ok then
					warn(`[Loader] Erreur dans {name}.Start : {err}`)
				end
			end)
		end
	end

	return loaded
end

return Loader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ReceptionCamera</string>
            <string name="Source"><![CDATA[--!strict
-- Position de la caméra quand on inspecte un client à la réception.
-- Isolé ici pour être testé (tests/run.luau vérifie que rien ne cache le client).

local ReceptionCamera = {}

-- rootCFrame : le HumanoidRootPart du client (il regarde le comptoir).
-- Renvoie la position de la caméra et le point visé.
function ReceptionCamera.compute(rootCFrame: CFrame): (Vector3, Vector3)
	local rootPosition = rootCFrame.Position
	-- Entre le comptoir et le client : rien ne cache ses pieds ni son ombre
	local eye = rootPosition + rootCFrame.LookVector * 5.5 + Vector3.new(0, 1.5, 0)
	-- On vise à droite du client pour qu'il apparaisse dans la moitié gauche
	-- (le panneau d'inspection occupe la droite de l'écran)
	local toGuest = (rootPosition - eye) * Vector3.new(1, 0, 1)
	local right = toGuest.Unit:Cross(Vector3.yAxis)
	local target = rootPosition - Vector3.new(0, 1.2, 0) + right * 3
	return eye, target
end

return ReceptionCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RigAppearance</string>
            <string name="Source"><![CDATA[--!strict
-- Applique des couleurs à un personnage R15 placeholder.
-- Utilisé par le serveur (clients, anomalies) et le client (photo d'identité).

local Types = require(script.Parent.Parent.Types)

local SKIN_PARTS = { "Head", "LeftHand", "RightHand" }
local SHIRT_PARTS = {
	"UpperTorso",
	"LowerTorso",
	"LeftUpperArm",
	"LeftLowerArm",
	"RightUpperArm",
	"RightLowerArm",
}
local PANTS_PARTS = {
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",
}

local RigAppearance = {}

local function paint(rig: Model, partNames: { string }, color: Color3)
	for _, name in partNames do
		local part = rig:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Color = color
		end
	end
end

function RigAppearance.apply(rig: Model, appearance: Types.Appearance)
	paint(rig, SKIN_PARTS, appearance.Skin)
	paint(rig, SHIRT_PARTS, appearance.Shirt)
	paint(rig, PANTS_PARTS, appearance.Pants)
end

-- Ajoute deux yeux lumineux sur la tête (indice « yeux anormaux »).
-- size : taille des yeux en studs (petit = indice discret)
function RigAppearance.addGlowingEyes(rig: Model, color: Color3, size: number)
	local head = rig:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	for _, side in { -1, 1 } do
		local eye = Instance.new("Part")
		eye.Name = "AnomalyEye"
		eye.Shape = Enum.PartType.Ball
		eye.Size = Vector3.new(size, size, size)
		eye.Material = Enum.Material.Neon
		eye.Color = color
		eye.CanCollide = false
		eye.CanQuery = false
		eye.CanTouch = false
		eye.Massless = true
		eye.CastShadow = false
		-- L'avant de la tête est le côté -Z (LookVector)
		eye.CFrame = head.CFrame * CFrame.new(side * head.Size.X * 0.18, head.Size.Y * 0.1, -head.Size.Z * 0.5)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = eye
		weld.Parent = eye
		eye.Parent = rig
	end
end

-- Active ou désactive l'ombre de toutes les pièces (indice « pas d'ombre »)
function RigAppearance.setCastShadow(rig: Model, enabled: boolean)
	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CastShadow = enabled
		end
	end
end

-- Couleur + matériau uniformes (mutations Dorée, Néon...)
function RigAppearance.applyMaterial(rig: Model, color: Color3, materialName: string)
	local ok, material = pcall(function()
		return (Enum.Material :: any)[materialName]
	end)
	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" and descendant.Name ~= "AnomalyEye" then
			descendant.Color = color
			if ok and material then
				descendant.Material = material
			end
		end
	end
end

-- Place un modèle debout sur une surface : ses pieds touchent floorCFrame.
function RigAppearance.placeOnFloor(rig: Model, floorCFrame: CFrame)
	rig:PivotTo(floorCFrame)
	local boxCFrame, boxSize = rig:GetBoundingBox()
	local bottom = boxCFrame.Position.Y - boxSize.Y / 2
	rig:PivotTo(floorCFrame + Vector3.new(0, floorCFrame.Position.Y - bottom, 0))
end

return RigAppearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Signal minimal pour la communication entre services d'un même côté
-- (serveur <-> serveur ou client <-> client).
-- Exemple : local onLoaded = Signal.new()
--           onLoaded:Connect(function(player) ... end)
--           onLoaded:Fire(player)

export type Connection = {
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, handler: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
}

local Signal = {}

function Signal.new(): Signal
	local handlers: { (...any) -> () } = {}

	local signal = {}

	function signal.Connect(_self: Signal, handler: (...any) -> ()): Connection
		table.insert(handlers, handler)
		local connection = {}
		function connection.Disconnect(_conn: Connection)
			local index = table.find(handlers, handler)
			if index then
				table.remove(handlers, index)
			end
		end
		return connection :: Connection
	end

	function signal.Fire(_self: Signal, ...: any)
		-- Copie : un handler peut se déconnecter pendant l'appel
		for _, handler in table.clone(handlers) do
			task.spawn(handler, ...)
		end
	end

	return signal :: Signal
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
