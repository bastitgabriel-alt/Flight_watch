          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
-- Boutique : bouton dans la barre du bas, fenêtre avec la liste des achats.
-- Les prix affichés viennent de ShopConfig ; le serveur revérifie tout.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Remotes = require(Shared:WaitForChild("Remotes"))
local GameConfig = require(Config:WaitForChild("GameConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local MonetizationConfig = require(Config:WaitForChild("MonetizationConfig"))
local MarketplaceService = game:GetService("MarketplaceService")
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Util = script.Parent.Parent:WaitForChild("Util")
local UI = require(Util:WaitForChild("UI"))
local HudBar = require(Util:WaitForChild("HudBar"))

local player = Players.LocalPlayer

local ShopController = {}

type Row = {
	category: string,
	itemId: string,
	order: number,
	-- Renvoie : titre, description, prix (nil = rien à acheter), texte si pas de prix
	describe: () -> (string, string, number?, string),
	-- Achat en Robux (gamepass ou produit) au lieu de l'argent du jeu
	robux: { kind: "Pass" | "Product", id: number, passName: string? }?,
}

local rows: { Row } = {}
local gui: ScreenGui
local list: ScrollingFrame

local function attribute(name: string): any
	return player:GetAttribute(name)
end

local function buildRows()
	table.insert(rows, {
		category = "Cell",
		itemId = "Cell",
		order = 1,
		describe = function()
			local unlocked = (attribute("CellsUnlocked") :: number?) or GameConfig.BaseCells
			local purchased = unlocked - GameConfig.BaseCells
			local price = ShopConfig.nextCellPrice(purchased)
			return `Cellule supplémentaire ({purchased}/{ShopConfig.Cells.MaxPurchasable})`,
				"Une place de plus pour enfermer une anomalie.",
				price,
				"MAX"
		end,
	})
	for toolId, tool in ShopConfig.Tools do
		table.insert(rows, {
			category = "Tool",
			itemId = toolId,
			order = 10 + tool.Order,
			describe = function()
				local owned = attribute(`Tool_{toolId}`) == true
				return tool.DisplayName, tool.Description, if owned then nil else tool.Price, "Acheté"
			end,
		})
	end
	for upgradeId, upgrade in ShopConfig.Security do
		table.insert(rows, {
			category = "Security",
			itemId = upgradeId,
			order = 20 + upgrade.Order,
			describe = function()
				local level = (attribute(`Sec_{upgradeId}`) :: number?) or 0
				local price = ShopConfig.nextSecurityPrice(upgradeId, level)
				return `{upgrade.DisplayName} (niv. {level}/{#upgrade.Prices})`, upgrade.Description, price, "MAX"
			end,
		})
	end
	-- Achats Robux (cachés tant que leur Id n'est pas renseigné dans MonetizationConfig)
	for passName, pass in MonetizationConfig.GamePasses do
		if pass.Id ~= 0 then
			table.insert(rows, {
				category = "Robux",
				itemId = passName,
				order = 30,
				describe = function()
					return `⭐ {pass.DisplayName}`, pass.Description, nil, "Acheté"
				end,
				robux = { kind = "Pass", id = pass.Id, passName = passName },
			})
		end
	end
	for _, product in MonetizationConfig.Products do
		if product.Id ~= 0 then
			table.insert(rows, {
				category = "Robux",
				itemId = tostring(product.Id),
				order = 40,
				describe = function()
					return `⭐ {product.DisplayName}`, product.Description, nil, ""
				end,
				robux = { kind = "Product", id = product.Id },
			})
		end
	end
	table.sort(rows, function(a, b)
		return a.order < b.order
	end)
end

type RowWidgets = { row: Row, title: TextLabel, button: TextButton }
local widgets: { RowWidgets } = {}

-- Crée les lignes une seule fois (les recréer à chaque seconde ferait rater des clics)
local function createRowWidgets()
	for index, row in rows do
		local frame = UI.new("Frame", {
			LayoutOrder = index,
			Size = UDim2.new(1, -8, 0, 70),
			BackgroundColor3 = Color3.fromRGB(45, 35, 55),
			Parent = list,
		}, { UI.corner(10), UI.padding(6) })
		local _, description = row.describe()
		local title = UI.new("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(0.68, 0.45),
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.new(1, 1, 1),
			Parent = frame,
		}, { UI.textSize(10, 20) })
		UI.new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0, 0.48),
			Size = UDim2.fromScale(0.68, 0.52),
			Font = Enum.Font.Gotham,
			TextScaled = true,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(200, 190, 210),
			Text = description,
			Parent = frame,
		}, { UI.textSize(8, 16) })
		local button = UI.new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromScale(0.3, 0.9),
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1),
			Parent = frame,
		}, { UI.corner(10), UI.padding(4), UI.textSize(10, 22) })
		button.Activated:Connect(function()
			local robux = row.robux
			if robux then
				if robux.kind == "Pass" then
					if not attribute(`Pass_{robux.passName}`) then
						MarketplaceService:PromptGamePassPurchase(player, robux.id)
					end
				else
					MarketplaceService:PromptProductPurchase(player, robux.id)
				end
				return
			end
			local _, _, price = row.describe()
			if price then
				Remotes.getEvent("ShopBuy"):FireServer(row.category, row.itemId)
			end
		end)
		table.insert(widgets, { row = row, title = title, button = button })
	end
end

-- Met à jour textes, prix et couleurs (argent, achats)
local function refresh()
	if not gui or not gui.Enabled then
		return
	end
	local money = (attribute("Money") :: number?) or 0
	for _, w in widgets do
		local title, _, price, doneText = w.row.describe()
		w.title.Text = title
		local robux = w.row.robux
		if robux then
			local owned = robux.kind == "Pass" and attribute(`Pass_{robux.passName}`) == true
			w.button.Text = if owned then doneText else "Robux"
			w.button.AutoButtonColor = not owned
			w.button.BackgroundColor3 = if owned then Color3.fromRGB(70, 70, 80) else Color3.fromRGB(0, 150, 90)
			continue
		end
		w.button.Text = if price then Format.money(price) else doneText
		w.button.AutoButtonColor = price ~= nil
		w.button.BackgroundColor3 = if price == nil
			then Color3.fromRGB(70, 70, 80)
			elseif money >= price then Color3.fromRGB(40, 160, 80)
			else Color3.fromRGB(120, 60, 60)
	end
end

local function buildGui()
	gui = UI.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local window = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.7, 0.75),
		BackgroundColor3 = Color3.fromRGB(25, 18, 30),
		Parent = gui,
	}, {
		UI.corner(18),
		UI.stroke(Color3.fromRGB(255, 200, 80), 2),
		UI.padding(10),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(560, 480), MinSize = Vector2.new(300, 240) }),
	})
	UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 0, 36),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		Text = "🛒 Boutique",
		Parent = window,
	})
	UI.new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Color3.fromRGB(70, 60, 80),
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "X",
		Parent = window,
	}, { UI.corner(8) }).Activated:Connect(function()
		gui.Enabled = false
	end)
	list = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -46),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window,
	}, {
		UI.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
	})
end

function ShopController.Start(_self: typeof(ShopController))
	buildRows()
	buildGui()
	createRowWidgets()

	local button = HudBar.addButton("Boutique", 1, Color3.fromRGB(200, 130, 30))
	button.Text = "🛒 Boutique"
	button.Activated:Connect(function()
		gui.Enabled = not gui.Enabled
		refresh()
	end)

	-- Mise à jour quand l'argent ou les possessions changent
	player.AttributeChanged:Connect(function(name)
		local prefix4, prefix5 = string.sub(name, 1, 4), string.sub(name, 1, 5)
		if name == "Money" or name == "CellsUnlocked" or prefix5 == "Tool_" or prefix4 == "Sec_" or prefix5 == "Pass_" then
			refresh()
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
-- Sons et petit « jumpscare » (flash rouge) quand une anomalie s'infiltre.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local SoundConfig = require(Shared:WaitForChild("Config"):WaitForChild("SoundConfig"))
local UI = require(script.Parent.Parent:WaitForChild("Util"):WaitForChild("UI"))

local player = Players.LocalPlayer

local SoundController = {}

local sounds: { [string]: Sound } = {}
local flash: Frame

function SoundController.Play(name: string)
	local sound = sounds[name]
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end

local function scare()
	SoundController.Play("Scare")
	flash.BackgroundTransparency = 0.25
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
end

function SoundController.Start(_self: typeof(SoundController))
	for name, entry in SoundConfig do
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = entry.Id
		sound.Volume = entry.Volume
		sound.Parent = SoundService
		sounds[name] = sound
	end

	local gui = UI.new("ScreenGui", {
		Name = "Flash",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		Parent = player:WaitForChild("PlayerGui"),
	})
	flash = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(150, 0, 0),
		BackgroundTransparency = 1,
		Active = false,
		Parent = gui,
	})

	Remotes.getEvent("Notify").OnClientEvent:Connect(function(_text, kind)
		if kind == "Good" then
			SoundController.Play("Good")
		elseif kind == "Bad" then
			SoundController.Play("Bad")
		end
	end)
	Remotes.getEvent("ReceptionResult").OnClientEvent:Connect(function(_token, outcome)
		if outcome == "Escaped" then
			scare()
		elseif outcome == "WrongCapture" then
			SoundController.Play("Bad")
		else
			SoundController.Play("Good")
		end
	end)
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
-- Tutoriel des nouveaux joueurs, en 3 étapes avec flèche et texte court :
--   1. recevoir le client au comptoir
--   2. décider (clé ou capture)
--   3. ouvrir la boutique

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UI = require(script.Parent.Parent:WaitForChild("Util"):WaitForChild("UI"))

local player = Players.LocalPlayer

local STEPS = {
	"Un client arrive au comptoir ! Approche-toi et appuie sur « Recevoir ».",
	"Compare le registre, la photo, son ombre et ses yeux. Puis donne la clé… ou capture-le !",
	"Tes anomalies rapportent de l'argent chaque seconde. Ouvre la Boutique pour t'agrandir !",
}

local TutorialController = {}

local function waitForTutorialState(): boolean
	while player:GetAttribute("TutorialDone") == nil do
		player:GetAttributeChangedSignal("TutorialDone"):Wait()
	end
	return player:GetAttribute("TutorialDone") == true
end

-- Flèche qui rebondit au-dessus d'un objet du monde
local function makeArrow(adornee: BasePart): BillboardGui
	local billboard = UI.new("BillboardGui", {
		Name = "TutorialArrow",
		Adornee = adornee,
		Size = UDim2.fromOffset(80, 80),
		StudsOffsetWorldSpace = Vector3.new(0, 8, 0),
		AlwaysOnTop = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local label = UI.new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 220, 60),
		TextStrokeTransparency = 0,
		Text = "⬇",
		Parent = billboard,
	})
	TweenService:Create(
		label,
		TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = UDim2.fromScale(0, 0.3) }
	):Play()
	return billboard
end

local function getGuestSpot(): BasePart?
	local index = player:GetAttribute("HotelIndex")
	local map = workspace:WaitForChild("Map")
	local hotel = index and map:WaitForChild("Hotels"):FindFirstChild(`Hotel{index}`)
	local spot = hotel and hotel:FindFirstChild("GuestSpot")
	return if spot and spot:IsA("BasePart") then spot else nil
end

function TutorialController.Start(_self: typeof(TutorialController))
	if waitForTutorialState() then
		return
	end

	local gui = UI.new("ScreenGui", {
		Name = "Tutorial",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local banner = UI.new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -95),
		Size = UDim2.new(0.5, 0, 0, 70),
		BackgroundColor3 = Color3.fromRGB(255, 200, 60),
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(30, 20, 10),
		Parent = gui,
	}, {
		UI.corner(12),
		UI.padding(8),
		UI.textSize(12, 22),
		UI.new("UISizeConstraint", { MinSize = Vector2.new(260, 60), MaxSize = Vector2.new(560, 90) }),
	})

	local function show(step: number)
		banner.Text = `({step}/3) {STEPS[step]}`
	end

	-- Placement : au-dessus de la barre du bas ; pendant la réception (panneau à
	-- droite, barre cachée), en bas de la moitié gauche pour ne rien cacher
	local receptionGui = player:WaitForChild("PlayerGui"):WaitForChild("Reception") :: ScreenGui
	local function place()
		if receptionGui.Enabled then
			banner.Position = UDim2.new(0.29, 0, 1, -12)
		else
			banner.Position = UDim2.new(0.5, 0, 1, -95)
		end
	end
	receptionGui:GetPropertyChangedSignal("Enabled"):Connect(place)
	place()

	-- Étape 1 : recevoir
	while not player:GetAttribute("HotelIndex") do
		player:GetAttributeChangedSignal("HotelIndex"):Wait()
	end
	show(1)
	local spot = getGuestSpot()
	local arrow = if spot then makeArrow(spot) else nil
	Remotes.getEvent("ReceptionShow").OnClientEvent:Wait()
	if arrow then
		arrow:Destroy()
	end
	Remotes.getEvent("TutorialStep"):FireServer(1)

	-- Étape 2 : décider
	show(2)
	Remotes.getEvent("ReceptionResult").OnClientEvent:Wait()
	Remotes.getEvent("TutorialStep"):FireServer(2)

	-- Étape 3 : ouvrir la boutique (on fait clignoter son bouton)
	task.wait(2.5) -- laisse le temps de lire le résultat
	show(3)
	local playerGui = player:WaitForChild("PlayerGui")
	local shopGui = playerGui:WaitForChild("Shop") :: ScreenGui
	local shopButton = playerGui:WaitForChild("Hud"):WaitForChild("BottomBar"):WaitForChild("Boutique") :: TextButton
	local stroke = shopButton:FindFirstChildOfClass("UIStroke")
	local pulse = if stroke
		then TweenService:Create(
			stroke,
			TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Color = Color3.fromRGB(255, 230, 80), Thickness = 5 }
		)
		else nil
	if pulse then
		pulse:Play()
	end
	while not shopGui.Enabled do
		shopGui:GetPropertyChangedSignal("Enabled"):Wait()
	end
	if pulse and stroke then
		pulse:Cancel()
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Thickness = 2
	end
	Remotes.getEvent("TutorialStep"):FireServer(3)

	banner.Text = "Bravo, tu es prêt ! Attention aux voleurs : pense à verrouiller ta porte. 🔒"
	task.wait(5)
	gui:Destroy()
end

return TutorialController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="63">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Point d'entrée du client : charge tous les contrôleurs du dossier Controllers,
-- appelle Init() sur chacun, puis Start().

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Loader = require(Shared:WaitForChild("Util"):WaitForChild("Loader"))

Loader.loadModules(script.Parent:WaitForChild("Controllers"))

print("[Client] Client prêt")
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="64">
