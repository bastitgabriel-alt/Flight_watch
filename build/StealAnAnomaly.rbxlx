        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">MutationConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Mutations : variante visuelle + multiplicateur de revenu.
-- D'autres mutations (Ombre x3, etc.) viendront après le MVP.

local Types = require(script.Parent.Parent.Types)

local MutationConfig: { [Types.MutationId]: Types.Mutation } = {
	None = {
		DisplayName = "Normale",
		IncomeMultiplier = 1,
		SpawnChance = 0, -- probabilité calculée : tout ce qui n'est pas muté
	},
	Golden = {
		DisplayName = "Dorée",
		IncomeMultiplier = 2,
		SpawnChance = 0.05,
		Color = Color3.fromRGB(255, 196, 48),
		Material = "Foil",
	},
	Neon = {
		DisplayName = "Néon",
		IncomeMultiplier = 5,
		SpawnChance = 0.01,
		Color = Color3.fromRGB(0, 255, 200),
		Material = "Neon",
	},
}

-- Ordre de tirage des mutations (la plus rare d'abord)
local ROLL_ORDER: { Types.MutationId } = { "Neon", "Golden" }

return {
	Mutations = MutationConfig,
	RollOrder = ROLL_ORDER,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">RarityConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Raretés des anomalies. Plus la rareté est haute, plus l'anomalie rapporte
-- (voir AnomalyConfig) et plus ses indices sont rares et discrets.
--
-- SpawnWeight : chances relatives qu'une anomalie soit de cette rareté.
-- HiddenClueChance : indice en plus, visible seulement avec la lampe UV ou le scanner.
-- Total = 100, donc chaque poids = pourcentage parmi les anomalies.
-- Objectif : 1re rare vers 10 min, 1re légendaire vers 1 h (voir tests/run.luau).

local Types = require(script.Parent.Parent.Types)

local RarityConfig: { [Types.RarityId]: Types.Rarity } = {
	Common = {
		DisplayName = "Commune",
		Color = Color3.fromRGB(190, 190, 190),
		Order = 1,
		SpawnWeight = 93,
		ClueCount = 2,
		SubtleChance = 0,
		HiddenClueChance = 0,
	},
	Rare = {
		DisplayName = "Rare",
		Color = Color3.fromRGB(70, 140, 255),
		Order = 2,
		SpawnWeight = 4,
		ClueCount = 1,
		SubtleChance = 0.2,
		HiddenClueChance = 0.4,
	},
	Epic = {
		DisplayName = "Épique",
		Color = Color3.fromRGB(170, 80, 255),
		Order = 3,
		SpawnWeight = 1.7,
		ClueCount = 1,
		SubtleChance = 0.5,
		HiddenClueChance = 0.6,
	},
	Legendary = {
		DisplayName = "Légendaire",
		Color = Color3.fromRGB(255, 190, 40),
		Order = 4,
		SpawnWeight = 1.1,
		ClueCount = 1,
		SubtleChance = 0.8,
		HiddenClueChance = 0.8,
	},
	Mythic = {
		DisplayName = "Mythique",
		Color = Color3.fromRGB(255, 60, 90),
		Order = 5,
		SpawnWeight = 0.2,
		ClueCount = 1,
		SubtleChance = 1,
		HiddenClueChance = 1,
	},
	-- Réservée aux événements admin (après le MVP) : n'apparaît jamais seule
	Secret = {
		DisplayName = "Secrète",
		Color = Color3.fromRGB(30, 30, 30),
		Order = 6,
		SpawnWeight = 0,
		ClueCount = 1,
		SubtleChance = 1,
		HiddenClueChance = 1,
	},
}

return RarityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ShopConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Boutique, verrou et vol. Tous les prix et durées sont ici.

local ShopConfig = {
	-- Cellules supplémentaires : prix = BasePrice x PriceGrowth ^ (nombre déjà achetées)
	Cells = {
		BasePrice = 150,
		PriceGrowth = 1.9,
		MaxPurchasable = 5, -- 8 de base + 5 achetées (+ 3 avec le gamepass) = 16 max
	},

	-- Outils de détection (achat unique). Chacun révèle un indice caché.
	Tools = {
		UVLamp = {
			DisplayName = "Lampe UV",
			Description = "Révèle les traces fluorescentes laissées par certaines anomalies.",
			Price = 400,
			Order = 1,
		},
		ThermalScanner = {
			DisplayName = "Scanner thermique",
			Description = "Mesure la température du client. Une anomalie est glacée.",
			Price = 2500,
			Order = 2,
		},
	},

	-- Améliorations de sécurité (plusieurs niveaux)
	Security = {
		LockPlus = {
			DisplayName = "Verrou renforcé",
			Description = "Ta porte reste verrouillée 20 s de plus par niveau.",
			Prices = { 800, 5000 },
			Order = 1,
		},
		SlowTrap = {
			DisplayName = "Piège ralentisseur",
			Description = "Les voleurs qui emportent tes anomalies avancent plus lentement.",
			Prices = { 1200, 7000 },
			Order = 2,
		},
	},

	Lock = {
		BaseDuration = 60, -- secondes de verrouillage
		BonusPerLevel = 20, -- + par niveau de « Verrou renforcé »
		Cooldown = 60, -- attente avant de pouvoir reverrouiller
	},

	Steal = {
		HoldDuration = 1.5, -- secondes à maintenir pour voler
		CarrySpeed = 11, -- vitesse du voleur chargé (normale : 16)
		TrapSpeeds = { 8, 6 }, -- vitesse selon le niveau du « Piège ralentisseur » de la victime
		Timeout = 90, -- l'anomalie retourne dans sa cellule après ce délai
	},
}

-- Prix de la prochaine cellule, ou nil si le maximum est atteint
function ShopConfig.nextCellPrice(purchased: number): number?
	if purchased >= ShopConfig.Cells.MaxPurchasable then
		return nil
	end
	return math.floor(ShopConfig.Cells.BasePrice * ShopConfig.Cells.PriceGrowth ^ purchased)
end

-- Prix du prochain niveau d'une amélioration, ou nil si niveau max
function ShopConfig.nextSecurityPrice(upgradeId: string, level: number): number?
	local upgrade = (ShopConfig.Security :: any)[upgradeId]
	if not upgrade then
		return nil
	end
	return upgrade.Prices[level + 1]
end

function ShopConfig.lockDuration(lockPlusLevel: number): number
	return ShopConfig.Lock.BaseDuration + ShopConfig.Lock.BonusPerLevel * lockPlusLevel
end

function ShopConfig.carrySpeed(slowTrapLevel: number): number
	return ShopConfig.Steal.TrapSpeeds[slowTrapLevel] or ShopConfig.Steal.CarrySpeed
end

return ShopConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
